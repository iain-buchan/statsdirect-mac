<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>ExportWorksheet</name>
  <friendly-name lang="en-GB">Export worksheet data</friendly-name>
  <help chm-id="1143" />
	<steps>
      <parameters>
        <frame>
          <name>data</name>
          <prompt>Select data to export (click at top left of sheet to export the entire worksheet)</prompt>
          <mode>Text</mode>
          <min-columns>1</min-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
      </parameters>
		<builtin function-name="fileExportWorksheet" />
	</steps>
</operation>
