<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
  <name>TransformLog10</name>
  <friendly-name lang="en-GB">Transformation: Log (base 10)</friendly-name>
  <help chm-id="1076" />
  <steps>
    <parameters>
      <frame>
        <name>data</name>
        <prompt>Select data for transformation</prompt>
        <mode>NumericReplaceMissing</mode>
        <min-columns>1</min-columns>
        <max-columns>1</max-columns>
      </frame>
      <special>
        <name>c</name>
        <prompt>="Enter constant c to make all x+c > 0 for log(x+c), or leave blank to skip impossible log(x) values.\n\nMinimum x in data selected is " + parameters["a_min"].AsDouble.ToString() + "."</prompt>
        <type>addedConstant</type>
      </special>
    </parameters>
    <builtin function-name="shtTransformLog10"/>
    <output-frame frame-name="output" />
  </steps>
</operation>
