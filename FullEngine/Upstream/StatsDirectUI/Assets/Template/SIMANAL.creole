<report>
<title>Simple regression - analysis</title>
<table>
<tr><th>Source of variation</th><th>Sum Squares</th><th>DF</th><th>Mean Square</th></tr>
<tr><td>Regression</td><td>@{reg_sum:roundu}</td><td>@reg_df</td><td>@{reg_mean:roundu}</td></tr>
<tr><td><ci>Residual</ci></td><td><ci>@{res_sum:roundu}</ci></td><td><ci>@res_df</ci></td><td><ci>@{res_mean:roundu}</ci></td></tr>
<tr><td><subtotal>Total, corrected</subtotal></td><td><subtotal>@{tot_sum:roundu}</subtotal></td><td><subtotal>@tot_df</subtotal></td><td></td></tr>
</table>

<p>F = @{f:roundu} <pval>@{p:pval}</pval></p>

<p>R square = @{r:roundu}<br />
Root MSE = @{mse:roundu}</p>
</report>
