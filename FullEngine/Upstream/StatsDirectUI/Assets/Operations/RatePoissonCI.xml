<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>RatePoissonCI</name>
  <friendly-name lang="en-GB">Poisson rate confidence interval</friendly-name>
  <help chm-id="1263" />
  <steps>
      <parameters>
        <double>
          <name>revents</name>
          <prompt>Number of events observed</prompt>
          <minimum-value>0</minimum-value>
          <must-request>true</must-request>
        </double>
        <double>
          <name>tar</name>
          <prompt>Time at risk of event during observation period (e.g. person-time)</prompt>
          <minimum-value>0</minimum-value>
          <must-request>true</must-request>
        </double>
        <confidence-interval>
          <name>cco</name>
          <must-request>true</must-request>
        </confidence-interval>
      </parameters>
  	<builtin function-name="rptRatePoissonCI" />
    <report type="application/x-statsdirect-creole" filename="prate.creole" />
	</steps>
  <suggested-operations>
    <suggested-operation>RatePoissonCI</suggested-operation>
  </suggested-operations>
</operation>
