<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>PCRCorrelation</name>
  <friendly-name lang="en-GB">Principal components analysis: correlation</friendly-name>
  <help chm-id="1280" />
  <steps>
      <parameters>
        <frame>
          <name>data</name>
          <prompt>Select DATA</prompt>
          <ask-for-group-id>false</ask-for-group-id>
          <same-length>true</same-length>
          <mode>NumericReplaceMissing</mode>
          <min-columns>2</min-columns>
          <max-columns>200</max-columns>
        </frame>
        <boolean>
          <name>correctForReversal</name>
          <prompt>Correct for possible scale reversal?</prompt>
          <default-value>true</default-value>
        </boolean>
      </parameters>
		<builtin function-name="rptPrincipalComponentsRegressionCorrelation" />
    <report type="application/x-statsdirect-creole" filename="princ.creole" />
	</steps>
  <suggested-operations>
    <suggested-operation>Cronbach</suggested-operation>
    <suggested-operation>PCRCoefficients</suggested-operation>
    <suggested-operation>PCRScores</suggested-operation>
    <suggested-operation>PCRMatrix</suggested-operation>
  </suggested-operations>
</operation>
