<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>ReferenceRange</name>
	<friendly-name lang="en-GB">Reference Range</friendly-name>
  <help chm-id="1240" />
  <steps>
      <parameters>
        <frame>
          <name>data</name>
          <prompt>Select DATA</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
        </frame>
        <confidence-interval>
          <name>reference-interval</name>
          <prompt>Reference interval (%)</prompt>
          <must-request>true</must-request>
          <lifetime>SessionForThisOperation</lifetime>
          <can-default>false</can-default>
          <can-use-standard>false</can-use-standard>
        </confidence-interval>
        <confidence-interval>
          <name>gamma</name>
          <prompt>Confidence interval (%)</prompt>
          <must-request>true</must-request>
          <lifetime>SessionForThisOperation</lifetime>
          <can-default>false</can-default>
          <can-use-standard>false</can-use-standard>
        </confidence-interval>
        <boolean>
          <name>do_conservative</name>
          <prompt>Conservative CI</prompt>
          <must-request>true</must-request>
          <lifetime>SessionForThisOperation</lifetime>
        </boolean>
      </parameters>
		<builtin function-name="rptReferenceRange" />
    <report type="application/x-statsdirect-creole" filename="refrange.creole" />
	</steps>
</operation>
