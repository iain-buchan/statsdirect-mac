<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>SizeMatchProp</name>
  <friendly-name lang="en-GB">Sample size for paired cohort study</friendly-name>
  <help chm-id="1317" />
  <steps>
      <parameters>
        <double>
          <name>p0</name>
          <prompt>Event rate in control group</prompt>
          <must-request>true</must-request>
        </double>
        <option>
          <name>er-or-rr</name>
          <prompt></prompt>
          <must-request>true</must-request>
          <default-value>er</default-value>
          <options>
            <option value="er">Event Rates</option>
            <option value="rr">Relative Risk</option>
          </options>
        </option>
        <double>
          <name>p1</name>
          <prompt>Event rate in experimental group</prompt>
          <must-request>true</must-request>
          <acquire-if-true language="c#">=!(parameters.ContainsKey("er-or-rr") &amp;&amp; "rr".Equals(parameters["er-or-rr"].AsString))</acquire-if-true>
        </double>
        <double>
          <name>rr</name>
          <prompt>Relative risk of failure for experimental subjects vs. controls</prompt>
          <must-request>true</must-request>
          <acquire-if-true language="c#">=parameters.ContainsKey("er-or-rr") &amp;&amp; "rr".Equals(parameters["er-or-rr"].AsString)</acquire-if-true>
        </double>
        <double>
          <name>ph</name>
          <prompt>Correlation coefficient for failure between paired subjects</prompt>
          <must-request>true</must-request>
          <minimum-value>0</minimum-value>
          <default-value>0.2</default-value>
        </double>
        <confidence-interval>
          <name>p</name>
          <prompt>% POWER (% probability of correctly detecting a real effect)</prompt>
          <must-request>true</must-request>
          <minimum-suggested-value>0.7</minimum-suggested-value>
          <maximum-suggested-value>0.95</maximum-suggested-value>
          <suggested-step>0.05</suggested-step>
          <default-value>0.8</default-value>
          <can-default>false</can-default>
        </confidence-interval>
        <confidence-interval>
          <name>a</name>
          <prompt>% ALPHA (% probability of incorrectly rejecting the null hypothesis)</prompt>
          <must-request>true</must-request>
          <minimum-suggested-value>0.001</minimum-suggested-value>
          <maximum-suggested-value>0.05</maximum-suggested-value>
          <suggested-step>0.001</suggested-step>
          <default-value>0.05</default-value>
          <can-default>false</can-default>
        </confidence-interval>
      </parameters>
  	<builtin function-name="rptSizeMatchProp" />
    <report type="application/x-statsdirect-creole" filename="s_maprop.creole" />
  </steps>
  <suggested-operations>
    <suggested-operation>SizeMatchProp</suggested-operation>
  </suggested-operations>
</operation>
