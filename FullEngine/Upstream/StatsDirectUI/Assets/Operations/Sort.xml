<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Sort</name>
	<friendly-name lang="en-GB">Sorting observations</friendly-name>
  <help chm-id="1086" />
  <steps>
      <parameters>
        <frame>
          <name>data</name>
          <prompt>Select data for SORTING</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
        </frame>
        <option>
          <name>sort</name>
          <prompt>Select sorting order</prompt>
          <default-value>asc</default-value>
          <options>
            <option value="asc">Sort ascending</option>
            <option value="desc">Sort descending</option>
          </options>
        </option>
        <boolean>
          <name>link</name>
          <prompt>Link to other variable</prompt>
        </boolean>
      </parameters>
    <test>
      <condition>=parameters["link"].AsBoolean</condition>
      <iftrue>
          <parameters>
            <frame>
              <name>linkdata</name>
              <prompt>Select data to LINK (Skip for none)</prompt>
              <cancel-skips-parameter>Skip</cancel-skips-parameter>
              <mode>NumericReplaceMissing</mode>
              <min-columns>1</min-columns>
              <max-columns>1</max-columns>
              <same-length-as>data</same-length-as>
              <clear-selection-first>true</clear-selection-first>
            </frame>
          </parameters>
      </iftrue>
    </test>
    <builtin function-name="shtSort"/>
    <output-frame frame-name="output" />
  </steps>
</operation>
