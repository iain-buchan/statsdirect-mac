<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
  <name>TSingleSummary</name>
  <friendly-name lang="en-GB">Single sample Student t test from summary statistics</friendly-name>
  <help chm-id="1241" />
  <steps>
    <parameters>
      <integer>
        <name>nx</name>
        <prompt>Sample size</prompt>
        <must-request>true</must-request>
        <minimum-value>2</minimum-value>
      </integer>
      <double>
        <name>mu</name>
        <prompt>Sample mean</prompt>
        <must-request>true</must-request>
      </double>
      <double>
        <name>sd1</name>
        <prompt>Sample standard deviation</prompt>
        <must-request>true</must-request>
        <minimum-value>0</minimum-value>
      </double>
      <double>
        <name>mu0</name>
        <prompt>Population mean</prompt>
        <must-request>true</must-request>
      </double>
      <confidence-interval>
        <name>gamma</name>
      </confidence-interval>
    </parameters>
    <builtin function-name="rptTSingleSummary" />
    <report type="application/x-statsdirect-creole" filename="m_single.creole" />
  </steps>
  <suggested-operations>
    <suggested-operation>TSingleSummary</suggested-operation>
  </suggested-operations>
</operation>
