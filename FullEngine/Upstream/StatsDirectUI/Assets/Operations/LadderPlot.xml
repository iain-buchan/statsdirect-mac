<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>LadderPlot</name>
  <friendly-name lang="en-GB">Ladder plot of changes in paired observations</friendly-name>
  <help chm-id="1127" />
  <steps>
      <parameters>
        <frame>
          <name>data</name>
          <prompt>Select DATA for PLOT</prompt>
          <ask-for-group-id>true</ask-for-group-id>
          <same-length>true</same-length>
          <mode>NumericReplaceMissing</mode>
          <min-columns>2</min-columns>
          <max-columns>2</max-columns>
        </frame>
      </parameters>
		<chart>
			<y-series-data>data</y-series-data>
			<chart-name>chart</chart-name>
			<chart-type>Ladder</chart-type>
			<box-axes>false</box-axes>
		</chart>
    <report type="application/x-statsdirect-creole" filename="chartonly.creole" />
	</steps>
</operation>
