<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
  <name>GroupExtract</name>
  <friendly-name lang="en-GB">Derive a variable from data based on rules</friendly-name>
  <help chm-id="1070" />
  <steps>
      <parameters>
        <frame>
          <name>data</name>
          <prompt>Select DATA from which to extract variables</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>200</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
      </parameters>
    <test>
      <condition>=parameters["data"].AsDataFrame.VariableCount == 1</condition>
      <iftrue>
          <parameters>
            <frame>
              <name>identifiers</name>
              <prompt>Select IDENTIFIERS for extraction rules</prompt>
              <mode>NumericReplaceMissing</mode>
              <min-columns>1</min-columns>
              <max-columns>9</max-columns>
              <same-length-as>data</same-length-as>
              <clear-selection-first>true</clear-selection-first>
            </frame>
          </parameters>
      </iftrue>
    </test>
    <builtin function-name="shtGroupExtract"/>
    <output-frame frame-name="extracted"/>
  </steps>
</operation>
