  <name>TwoWayNested</name>
  <friendly-name lang="en-GB">Two way hierarchical (nested) analysis of variance</friendly-name>
  <help chm-id="1010" />
  <steps>
    <parameters>
      <frame2d>
        <name>data2d</name>
        <prompt></prompt>
        <sub-prompt>Select SUB-GROUP IDENTIFIER</sub-prompt>
        <same-length>true</same-length>
        <mode>GroupThenBlock</mode>
        <min-columns>2</min-columns>
        <max-columns>10</max-columns>
      </frame2d>
    </parameters>
    <builtin function-name="rptTwoNest" />
    <report type="application/x-statsdirect-creole" filename="twonest.creole" />
