<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>QuickSummary</name>
  <friendly-name lang="en-GB">Univariate descriptive summary statistics</friendly-name>
  <help chm-id="1045" />
  <steps>
      <parameters>
        <confidence-interval>
          <name>gamma</name>
        </confidence-interval>
        <frame>
          <name>data</name>
          <prompt>Select data for quick summary</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
        </frame>
      </parameters>
	  <builtin function-name="quickSummary" />
	</steps>
</operation>
