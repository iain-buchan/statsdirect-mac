<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>PyramidPlot</name>
  <friendly-name lang="en-GB">Population pyramid plot</friendly-name>
  <help chm-id="1130" />
  <steps>
      <parameters>
        <frame>
          <name>male</name>
          <prompt>Select NUMBERS in AGE GROUPS [MALE or TOTAL]</prompt>
          <validators>
            <validator><name>NonNegative</name></validator>
          </validators>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>female</name>
          <prompt>Select NUMBERS in FEMALE AGE GROUPS [skip if using total]</prompt>
          <cancel-skips-parameter>Skip</cancel-skips-parameter>
          <validators>
            <validator><name>NonNegative</name></validator>
          </validators>
          <same-length>true</same-length>
          <mode>NumericReplaceMissing</mode>
          <same-length-as>Male</same-length-as>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>labels</name>
          <prompt>Select group LABELS [skip for none]</prompt>
          <cancel-skips-parameter>Skip</cancel-skips-parameter>
          <same-length>true</same-length>
          <mode>Text</mode>
          <same-length-as>Male</same-length-as>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
      </parameters>
		<chart>
			<chart-name>chart</chart-name>
			<chart-type>Pyramid</chart-type>
			<box-axes>false</box-axes>
		</chart>
    <report type="application/x-statsdirect-creole" filename="chartonly.creole" />
	</steps>
</operation>
