<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Dates</name>
	<friendly-name lang="en-GB">Calculate date and time intervals</friendly-name>
  <help chm-id="1066" />
  <steps>
      <parameters>
        <frame>
          <name>data</name>
          <prompt>Select a column of dates</prompt>
          <mode>DateReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
        </frame>
        <date>
          <name>indate</name>
          <prompt>Time or date from</prompt>
          <default-value>=DateTime.Today</default-value>
          <rubric>Enter a date (e.g. 1/3/70), a time (e.g. 10:00:00) or both date and time (e.g. 1/3/70 10:00:00).</rubric>
        </date>
        <option>
          <name>interval</name>
          <columns>2</columns>
          <prompt>Select an interval</prompt>
          <default-value>d</default-value>
          <rubric>The reference time/date that you enter is subtracted from the values you have selected in the worksheet in order to give an interval in these units.</rubric>
          <options>
            <option value="d">Days</option>
            <option value="h">Hours</option>
            <option value="w">Weeks</option>
            <option value="n">Minutes</option>
            <option value="m">Months</option>
            <option value="s">Seconds</option>
            <option value="yyyy">Years</option>
          </options>
        </option>
      </parameters>
    <builtin function-name="shtDates"/>
    <output-frame frame-name="output" />
	</steps>
</operation>
