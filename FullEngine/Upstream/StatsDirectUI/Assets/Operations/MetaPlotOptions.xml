<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>MetaPlotOptions</name>
  <friendly-name lang="en-GB">Meta-analysis plot options</friendly-name>
  <help chm-id="1166" />
  <steps>
      <parameters>
        <option>
          <name>meta-plot-method</name>
          <prompt>Vertical Axis in Meta-Analysis Bias Plot</prompt>
          <default-value>=host.Preferences.MetaPlotMethod.ToString()</default-value>
          <options>
            <option value="1">standard error</option>
            <option value="2">precision</option>
            <option value="3">1/sample size</option>
            <option value="4">sample size</option>
            <option value="5">1/log(sample size)</option>
            <option value="6">log(sample size)</option>
            <option value="7">1/MH weight</option>
          </options>
        </option>
        <boolean>
          <name>meta-plot-ci</name>
          <prompt>Include confidence interval if relevant</prompt>
          <default-value>=host.Preferences.MetaPlotCI</default-value>
        </boolean>
      </parameters>
    <script language="CSharp"><![CDATA[
SDPreferences preferences = host.Preferences;
preferences.MetaPlotCI = parameters["meta-plot-ci"].AsBoolean;
preferences.MetaPlotMethod = Parsing.Cint_Txt(parameters["meta-plot-method"].AsString);
return new ParameterBag();
    ]]></script>
	</steps>
</operation>
