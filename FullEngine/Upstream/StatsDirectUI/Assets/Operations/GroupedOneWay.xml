<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>GroupedOneWay</name>
	<friendly-name lang="en-GB">Grouped one way analysis of variance</friendly-name>
  <help chm-id="1011" />
  <steps>
      <parameters>
        <frame>
          <clear-selection-first>true</clear-selection-first>
          <name>data</name>
          <prompt>Select DATA (each column will be treated as a separate analysis)</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>200</max-columns>
          <ask-for-group-id>true</ask-for-group-id>
        </frame>
        <frame>
          <clear-selection-first>true</clear-selection-first>
          <name>groups</name>
          <prompt>Select block/row classifier</prompt>
          <mode>CategoryReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
        </frame>
      </parameters>
		<builtin function-name="rptGroupedOneWay" />
    <report type="application/x-statsdirect-creole" filename="groupedoneway.creole" />
	</steps>
</operation>
