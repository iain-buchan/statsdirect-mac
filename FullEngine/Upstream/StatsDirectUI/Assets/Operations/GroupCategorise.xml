<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>GroupCategorise</name>
	<friendly-name lang="en-GB">Categorise observations into groups</friendly-name>
  <help chm-id="1059" />
  <steps>
      <parameters>
        <frame>
          <name>data</name>
          <prompt>Select data to CATEGORISE into groups</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
        </frame>
      </parameters>
    <builtin function-name="shtGroupCategorise"/>
    <output-frame frame-name="output" />
	</steps>
</operation>
