<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Rank</name>
	<friendly-name lang="en-GB">Ranking observations</friendly-name>
  <help chm-id="1083" />
  <steps>
      <parameters>
        <frame>
          <name>data</name>
          <prompt>Select data for RANKING</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
        </frame>
        <option>
          <name>tie-correction</name>
          <prompt>Select tie correction</prompt>
          <default-value>1</default-value>
          <options>
            <option value="1">None</option>
            <option value="2">Sum t^3 - t / 12</option>
            <option value="3">Sum t * (t-1) / 2</option>
            <option value="4">Sum t * (t-1) * (2*t+5)</option>
            <option value="5">Sum t * (t-1) * (t-2)</option>
          </options>
        </option>
      </parameters>
    <builtin function-name="shtRank"/>
    <output-frame frame-name="output" />
	</steps>
</operation>
