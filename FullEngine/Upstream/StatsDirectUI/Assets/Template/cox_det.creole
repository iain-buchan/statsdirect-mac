<report>
<title>Cox regression - hazard ratios</title>
<table>
<tr><th>Parameter</th><th>Hazard Ratio</th><th><ci>@{pc2:round2}% CI</ci></th></tr>
<block name="hazard"><tr><td>@par</td><td>@{ec:roundu}</td><td><ci>@{ell:roundu}  to  @{eul:roundu}</ci></td></tr></block>
</table>

<table>
<tr><th>Parameter</th><th>Coefficient</th><th>Standard Error</th></tr>
<block name="parameter"><tr><td>@par</td><td>@{coef:roundu}</td><td>@{se:roundu}</td></tr></block>
</table>
</report>
