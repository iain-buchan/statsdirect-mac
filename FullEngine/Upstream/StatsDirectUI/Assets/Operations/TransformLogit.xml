<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
  <name>TransformLogit</name>
  <help chm-id="1075" />
  <friendly-name lang="en-GB">Transformation: Logit</friendly-name>
  <steps>
    <parameters>
      <frame>
        <name>data</name>
        <prompt>Select data for transformation</prompt>
        <mode>NumericReplaceMissing</mode>
        <min-columns>1</min-columns>
        <max-columns>1</max-columns>
      </frame>
      <option>
        <name>discrete</name>
        <prompt>Logit transformation</prompt>
        <default-value>discrete</default-value>
        <options>
          <option value="discrete">Discrete data</option>
          <option value="proportion">Proportions</option>
        </options>
      </option>
    </parameters>
    <builtin function-name="shtTransformLogit"/>
    <output-frame frame-name="output" />
  </steps>
</operation>
