<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>CochranePlot</name>
  <friendly-name lang="en-GB">Forest (Cochrane) plot</friendly-name>
  <help chm-id="1116" />
  <steps>
      <parameters>
        <frame>
          <name>odds</name>
          <prompt>Select SUMMARY STATISTIC (e.g. odds ratio)</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>lci</name>
          <prompt>Select LOWER confidence limit</prompt>
          <mode>NumericReplaceMissing</mode>
          <same-length-as>odds</same-length-as>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>uci</name>
          <prompt>Select UPPER confidence limit</prompt>
          <mode>NumericReplaceMissing</mode>
          <same-length-as>odds</same-length-as>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>gn</name>
          <prompt>Select GROUP SIZE/WEIGHT [skip for none]</prompt>
          <cancel-skips-parameter>Skip</cancel-skips-parameter>
          <mode>NumericReplaceMissing</mode>
          <same-length-as>odds</same-length-as>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>pg</name>
          <prompt>Select POOLING INDICATOR [skip for none]</prompt>
          <cancel-skips-parameter>Skip</cancel-skips-parameter>
          <validators>
            <validator><name>Pooling</name></validator>
          </validators>
          <mode>NumericReplaceMissing</mode>
          <same-length-as>odds</same-length-as>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>title</name>
          <prompt>Select stratum LABELS [skip for default]</prompt>
          <cancel-skips-parameter>Skip</cancel-skips-parameter>
          <mode>Text</mode>
          <same-length-as>odds</same-length-as>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
      </parameters>
		<chart>
			<chart-type>Forest</chart-type>
			<chart-name>chart</chart-name>
			<box-axes>false</box-axes>
		</chart>
    <report type="application/x-statsdirect-creole" filename="chartonly.creole" />
	</steps>
</operation>
