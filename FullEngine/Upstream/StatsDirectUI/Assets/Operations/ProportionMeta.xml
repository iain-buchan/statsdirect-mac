<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>ProportionMeta</name>
  <friendly-name lang="en-GB">Meta-analysis of proportions</friendly-name>
  <help chm-id="1169" />
  <steps>
      <parameters>
        <confidence-interval>
          <name>gamma</name>
        </confidence-interval>
        <frame>
          <name>sn</name>
          <prompt>Select TOTAL number of subjects (n) studied</prompt>
          <validators>
            <validator><name>Positive</name></validator>
          </validators>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>sr</name>
          <prompt>Select number of subjects (r) with OUTCOME</prompt>
          <validators>
            <validator><name>NonNegative</name></validator>
          </validators>
          <same-length-as>sn</same-length-as>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>strata</name>
          <prompt>Select stratum LABELS [Default for default]</prompt>
          <cancel-skips-parameter>Default</cancel-skips-parameter>
          <same-length-as>sn</same-length-as>
          <mode>Text</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <!-- Removed as part of #893
        <option>
          <name>fudge</name>
          <prompt>Weights = n +</prompt>
          <prompt-precedes-parameter>true</prompt-precedes-parameter>
          <default-value>0.5</default-value>
          <format-type>Dropdown</format-type>
          <options>
            <option value="0.5">0.5</option>
            <option value="1">1.0</option>
          </options>
        </option>
        -->
        <option>
          <name>method</name>
          <prompt>Inverse transform</prompt>
          <prompt-precedes-parameter>true</prompt-precedes-parameter>
          <default-value>arcsine</default-value>
          <format-type>Dropdown</format-type>
          <options>
            <option value="arcsine">Stuart-Ord</option>
            <option value="doubleArcsine">Miller</option>
          </options>
        </option>
      </parameters>
		<builtin function-name="rptProportionMeta" />
    <report type="application/x-statsdirect-creole" filename="propmeta.creole" />
    <report type="application/x-statsdirect-creole" filename="charts.creole" />
	</steps>
</operation>
