<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Standardize</name>
	<friendly-name lang="en-GB">Standardization of variables</friendly-name>
  <help chm-id="1088" />
  <steps>
      <parameters>
        <option>
          <name>mode</name>
          <prompt>Select standardization method</prompt>
          <columns>1</columns>
          <default-value>msd</default-value>
          <options>
            <option value="msd">subtract mean and divide by SD</option>
            <option value="sd">divide by SD only</option>
            <option value="m">subtract mean only</option>
            <option value="ecdf">z (empirical CDF)</option>
          </options>
        </option>
        <frame>
          <name>data</name>
          <prompt>Select data for STANDARDIZATION</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
        </frame>
      </parameters>
    <builtin function-name="shtStandardize"/>
    <output-frame frame-name="output" />
	</steps>
</operation>
