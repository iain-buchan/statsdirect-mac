<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>RateDirect</name>
	<friendly-name lang="en-GB">Direct standardization</friendly-name>
  <help chm-id="1260" />
  <steps>
      <parameters>
        <confidence-interval>
          <name>cco</name>
        </confidence-interval>
        <frame>
          <name>idxn</name>
          <prompt>Select EVENTS in INDEX population or sample</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>times</name>
          <prompt>Select PERSON-TIME for INDEX population or sample</prompt>
          <mode>NumericReplaceMissing</mode>
          <same-length-as>events</same-length-as>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>refn</name>
          <prompt>Select GROUP SIZES for REFERENCE population</prompt>
          <mode>NumericReplaceMissing</mode>
          <same-length-as>events</same-length-as>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>strata</name>
          <prompt>Select standardization group LABELS [Default for default]</prompt>
          <cancel-skips-parameter>Default</cancel-skips-parameter>
          <same-length-as>events</same-length-as>
          <mode>Text</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <option>
          <name>nunit</name>
          <prompt>Multiplier for reference population rates</prompt>
          <default-value>1</default-value>
          <format-type>Dropdown</format-type>
          <options>
            <option value="1">1 (rate)</option>
            <option value="10">per 10</option>
            <option value="100">per 100</option>
            <option value="1000">per 1,000</option>
            <option value="10000">per 10,000</option>
            <option value="100000">per 100,000</option>
            <option value="1000000">per 1,000,000</option>
            <option value="10000000">per 10,000,000</option>
            <option value="100000000">per 100,000,000</option>
          </options>
        </option>
      </parameters>
		<builtin function-name="rptRateDirect" />
    <report type="application/x-statsdirect-creole" filename="dstdr.creole" />
	</steps>
</operation>
