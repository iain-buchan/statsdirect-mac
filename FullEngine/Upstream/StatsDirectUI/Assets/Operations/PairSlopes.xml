<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>PairSlopes</name>
	<friendly-name lang="en-GB">Pairwise slopes</friendly-name>
  <help chm-id="1081" />
  <steps>
      <parameters>
        <frame>
          <name>y</name>
          <prompt>Select Y</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>x</name>
          <prompt>Select X</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
          <same-length-as>y</same-length-as>
        </frame>
        <boolean>
          <name>calculate-slope</name>
          <prompt>Calculate median slope with confidence interval?</prompt>
        </boolean>
        <confidence-interval>
          <name>gamma</name>
        </confidence-interval>
      </parameters>
    <builtin function-name="shtPairSlopes"/>
    <output-frame frame-name="output" />
	</steps>
</operation>
