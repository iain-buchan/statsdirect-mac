<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>KaplanMeier</name>
  <friendly-name lang="en-GB">Kaplan-Meier product limit estimates of survival</friendly-name>
  <help chm-id="1323" />
  <steps>
      <parameters>
        <confidence-interval>
          <name>gamma</name>
        </confidence-interval>
        <boolean>
          <name>use-tics</name>
          <prompt>Show censorship tics</prompt>
          <default-value>true</default-value>
        </boolean>
        <boolean>
          <name>use-markers</name>
          <prompt>Show event markers</prompt>
        </boolean>
        <boolean>
          <name>save</name>
          <prompt>Save estimates and CIs to worksheet?</prompt>
        </boolean>
        <frame>
          <name>times</name>
          <prompt>Select data for TIMES</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>deaths</name>
          <prompt>Select data for DEATHS/EVENTS or CENSORED{0}</prompt>
          <same-length-as>times</same-length-as>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>groups</name>
          <prompt>Select data for GROUP IDENTIFIER (skip if not grouped)</prompt>
          <cancel-skips-parameter>Skip</cancel-skips-parameter>
          <same-length-as>times</same-length-as>
          <mode>CategoryReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
      </parameters>
		<builtin function-name="rptKaplanMeier" />
		<test>
			<condition>=parameters.ContainsKey("results")</condition>
			<iftrue>
				<output-frame frame-name="results" />
			</iftrue>
		</test>
    <report type="application/x-statsdirect-creole" filename="kap_meir.creole" />
		<builtin function-name="rptKaplanMeierPlots" />
    <report type="application/x-statsdirect-creole" filename="charts.creole" />
	</steps>
</operation>
