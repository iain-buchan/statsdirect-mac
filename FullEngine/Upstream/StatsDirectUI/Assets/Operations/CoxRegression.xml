<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>CoxRegression</name>
  <friendly-name lang="en-GB">Cox (proportional hazards) regression</friendly-name>
  <help chm-id="1322" />
  <steps>
      <parameters>
        <frame>
          <name>times</name>
          <prompt>Select data for TIMES</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>events</name>
          <prompt>Select data for DEATHS/EVENTS or CENSORED{0}</prompt>
          <same-length-as>times</same-length-as>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>predictors</name>
          <prompt>Select data for PREDICTORS</prompt>
          <same-length-as>times</same-length-as>
          <mode>NumericCodingTextToDummies</mode>
          <min-columns>1</min-columns>
          <max-columns>200</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>strata</name>
          <prompt>Select data for STRATA (skip if all one stratum)</prompt>
          <cancel-skips-parameter>Skip</cancel-skips-parameter>
          <same-length-as>times</same-length-as>
          <mode>CategoryReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <double>
          <name>accuracy</name>
          <prompt>Precision of estimates</prompt>
          <default-value>0.0000001</default-value>
          <minimum-value>0</minimum-value>
        </double>
        <double>
          <name>splitting-ratio</name>
          <rubric>SPLITTING RATIO:  At any event time x, if the ratio of the proportionality constant at all times before x is more than R times that for all times after x then StatsDirect splits the data into another stratum.  R is the ratio to enter below.</rubric>
          <default-value>1000</default-value>
        </double>
        <boolean>
          <name>centre-continuous-covariates</name>
          <prompt>Centre continuous covariates</prompt>
          <default-value>true</default-value>
        </boolean>
      </parameters>
    <builtin function-name="rptCoxRegressionPreprocess" />
    <test>
      <condition>=parameters.ContainsKey("timesAdjustment")</condition>
      <iftrue>
        <parameters>
          <boolean>
            <name>useTimesAdjustment</name>
            <prompt>="Times must be > 0: Do you want to add " + parameters["timesAdjustment"].AsDouble.ToString() + " to all of your times?"</prompt>
            <must-request>true</must-request>
            <default-value>true</default-value>
          </boolean>
        </parameters>
      </iftrue>
    </test>
    <builtin function-name="rptCoxRegression" />
    <report type="application/x-statsdirect-creole" filename="coxreg.creole" />
	</steps>
  <suggested-operations>
    <suggested-operation>CoxBaselineToReport</suggested-operation>
    <suggested-operation>CoxBaselineToWorksheet</suggested-operation>
    <suggested-operation>CoxResiduals</suggested-operation>
    <suggested-operation>CoxHazardRatios</suggested-operation>
    <suggested-operation>CoxModelAnalysis</suggested-operation>
    <suggested-operation>CoxHazardPlots</suggested-operation>
  </suggested-operations>
</operation>
