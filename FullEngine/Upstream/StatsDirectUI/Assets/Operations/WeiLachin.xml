<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
  <name>WeiLachin</name>
  <friendly-name lang="en-GB">Wei-Lachin test</friendly-name>
  <help chm-id="1327" />
  <steps>
    <parameters>
      <frame>
        <name>gid</name>
        <prompt>Select data for GROUP IDENTIFIER</prompt>
        <validators>
          <validator><name>TwoBinsAndNoMissingData</name></validator>
        </validators>
        <mode>CategoryReplaceMissing</mode>
        <min-columns>1</min-columns>
        <max-columns>1</max-columns>
        <clear-selection-first>true</clear-selection-first>
      </frame>
      <integer>
        <name>nr</name>
        <prompt>Number of repeat times</prompt>
        <minimum-value>1</minimum-value>
        <default-value>1</default-value>
      </integer>
    </parameters>
    <!-- Construct two frames, "times" and "censor", with variables[0..nr - 1] for each of the repeats -->
    <iteration>
      <lower-bound>1</lower-bound>
      <upper-bound-parameter>nr</upper-bound-parameter>
      <loop-variable-name>repeat</loop-variable-name>
      <steps>
        <parameters>
          <frame>
            <name>scrapTimes</name>
            <prompt>="Select data for TIMES (repeat " + parameters["repeat"].AsObject.ToString() + ")"</prompt>
            <must-request>true</must-request>
            <same-length-as>gid</same-length-as>
            <mode>NumericReplaceMissing</mode>
            <min-columns>1</min-columns>
            <max-columns>1</max-columns>
            <append-to-frame>times</append-to-frame>
            <clear-selection-first>true</clear-selection-first>
          </frame>
          <frame>
            <name>scrapCensor</name>
            <prompt>="Select data for CENSORSHIP (repeat " + parameters["repeat"].AsObject.ToString() + ")"</prompt>
            <must-request>true</must-request>
            <validators>
              <validator><name>Boolean</name></validator>
            </validators>
            <validation-fail-message>Censorship value must be 0 or 1 only</validation-fail-message>
            <same-length-as>gid</same-length-as>
            <mode>NumericReplaceMissing</mode>
            <min-columns>1</min-columns>
            <max-columns>1</max-columns>
            <append-to-frame>censor</append-to-frame>
            <clear-selection-first>true</clear-selection-first>
          </frame>
        </parameters>
      </steps>
    </iteration>
    <builtin function-name="rptWeiLachin" />
    <report type="application/x-statsdirect-creole" filename="wei.creole" />
  </steps>
</operation>
