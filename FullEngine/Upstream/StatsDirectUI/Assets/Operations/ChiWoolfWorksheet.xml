<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>ChiWoolfWorksheet</name>
  <friendly-name lang="en-GB">Chi-square 2-by-2-by-k Woolf test</friendly-name>
  <help chm-id="1056" />
  <steps>
      <parameters>
        <confidence-interval>
          <name>cco</name>
        </confidence-interval>
        <frame>
          <name>sn</name>
          <prompt>Select subgroup SIZES for EXPERIMENTAL group</prompt>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <mode>NumericReplaceMissing</mode>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>sr</name>
          <prompt>Select numbers of EXPERIMENTAL subjects with DISEASE/OUTCOME</prompt>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <same-length-as>sn</same-length-as>
          <mode>NumericReplaceMissing</mode>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>xn</name>
          <prompt>Select subgroup SIZES for the CONTROL group</prompt>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <same-length-as>sn</same-length-as>
          <mode>NumericReplaceMissing</mode>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>xr</name>
          <prompt>Select numbers of CONTROL subjects with DISEASE/OUTCOME</prompt>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <same-length-as>sn</same-length-as>
          <mode>NumericReplaceMissing</mode>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <boolean>
          <name>show_intermediates</name>
          <prompt>Show intermediates</prompt>
          <must-request>true</must-request>
          <column>2</column>
        </boolean>
      </parameters>
  	<builtin function-name="rptChiWoolfWorksheet" />
    <report type="application/x-statsdirect-creole" filename="woolf.creole" />
  </steps>
</operation>
