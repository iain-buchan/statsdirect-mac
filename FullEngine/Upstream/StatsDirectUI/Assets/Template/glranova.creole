<report>
<title>Analysis of variance from regression</title>
<table>
<tr><th>Source of variation</th><th>Sum Squares</th><th>DF</th><th>Mean Square</th></tr>
<tr><td>Regression</td><td>@{reg_sum:roundu}</td><td>@reg_df</td><td>@{reg_mean:roundu}</td></tr>
<tr><td>Residual</td><td>@{res_sum:roundu}</td><td>@res_df</td><td>@{res_mean:roundu}</td></tr>
<tr><td><grandtotal>Total (corrected)</grandtotal></td><td><grandtotal>@{tot_sum:roundu}</grandtotal></td><td><grandtotal>@tot_df</grandtotal></td><td></td></tr>
</table>

<p>Root MSE = @{mse:roundu}</p>

<p>F = @{f:roundu} <pval>@{p:pval}</pval></p>

<table>
<tr><td>Multiple correlation coefficient</td><td>(R) = @{r:roundu}@r_extra</td></tr>
<tr><td></td><td>R&#xb2;  = @r2%</td></tr>
<tr><td></td><td>Ra&#xb2; = @{ra2:roundu}%</td></tr>
</table>

<p>Durbin-Watson test statistic = @{dw:roundu}</p>
</report>
