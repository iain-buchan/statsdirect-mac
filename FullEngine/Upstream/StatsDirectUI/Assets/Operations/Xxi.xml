<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
  <name>Xxi</name>
  <friendly-name lang="en-GB">XXi (hat) and (co)variance matrix</friendly-name>
  <prerequisite-operation>MultipleLinearRegression</prerequisite-operation>
  <steps>
    <parameters>
      <boolean>
        <name>outputToGrid</name>
        <prompt>Save matrices to a workbook as well as report?</prompt>
        <must-request>true</must-request>
        <default-value>true</default-value>
      </boolean>
    </parameters>
    <builtin function-name="rptXxi" />
    <test>
      <condition>=parameters["outputToGrid"].AsBoolean</condition>
      <iftrue>
        <output-frame frame-name="data" />
      </iftrue>
    </test>
    <report type="application/x-statsdirect-creole" filename="xxi.creole" />
    <report type="application/x-statsdirect-creole" filename="covarmx.creole" />
  </steps>
</operation>
