<report>
<p>With raw variables:</p>

<table>
<tr><td>Scale reliability alpha =</td><td>@{raw_t:roundu}  <ci>(@{pc:round2}% lower confidence limit = @{raw_cl:roundu})</ci><u></u></td></tr>
</table>

<table>
<tr><th>Variable dropped</th><th>Alpha</th><th></th><th>Change</th><subtotal></subtotal></tr>
<block name="raw"><tr><td><subtotal>@lab</subtotal></td><td></td><td>@{a:roundu}</td><td>@x</td><td>@{a-t:roundu}</td></tr></block>
</table>

<p>With standardized variables:</p>

<table>
<tr><td>Scale reliability alpha =</td><td>@{standard_t:roundu} <ci>(@{pc:round2}% lower confidence limit = @{standard_cl:roundu})</ci><u></u></td></tr>
</table>

<table>
<tr><th>Variable dropped</th><th>Alpha</th><th></th><th>Change</th></tr>
<block name="standard"><tr><td><subtotal>@lab</subtotal></td><td></td><td>@{a:roundu}</td><td>@x</td><td>@{a-t:roundu}</td></tr></block>
</table>
</report>
