<report>
<title>Sample size for a population survey</title>
<table>
<tr><td>Population estimate</td><td>@{estimate:roundu}</td></tr>
<tr><td>Population rate</td><td>@{rate:roundu}%</td></tr>
<tr><td>Maximum deviation</td><td>&#xb1;@{deviation:roundu}%</td></tr>
<tr><td>Confidence level</td><td>@{level:roundu}</td></tr>
</table>

<p>Estimated minimum sample size = @size</p>
</report>
