<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
  <name>UniversalAgreement</name>
  <friendly-name lang="en-GB">Universal agreement statistic R</friendly-name>
  <help chm-id="1004" />
  <steps>
    <parameters>
      <frame>
        <name>data</name>
        <prompt>Select MEASUREMENTS</prompt>
        <title>Measurements</title>
        <mode>NumericReplaceMissing</mode>
        <min-columns>1</min-columns>
        <max-columns>1</max-columns>
        <ask-for-group-id>false</ask-for-group-id>
        <clear-selection-first>true</clear-selection-first>
      </frame>
      <frame>
        <name>raters</name>
        <prompt>Select OBSERVER/RATER ID</prompt>
        <title>Observers/Raters</title>
        <same-length-as>data</same-length-as>
        <mode>CategoryReplaceMissing</mode>
        <min-columns>1</min-columns>
        <max-columns>1</max-columns>
        <ask-for-group-id>false</ask-for-group-id>
        <clear-selection-first>true</clear-selection-first>
      </frame>
      <frame>
        <name>objects</name>
        <prompt>Select OBJECT ID</prompt>
        <title>Objects</title>
        <same-length-as>data</same-length-as>
        <mode>CategoryReplaceMissing</mode>
        <min-columns>1</min-columns>
        <max-columns>1</max-columns>
        <ask-for-group-id>false</ask-for-group-id>
        <clear-selection-first>true</clear-selection-first>
      </frame>
      <frame>
        <name>categories</name>
        <prompt>Select DIMENSION ID (skip if only one dimension)</prompt>
        <cancel-skips-parameter>Skip</cancel-skips-parameter>
        <title>Dimensions/Categories</title>
        <same-length-as>data</same-length-as>
        <mode>CategoryReplaceMissing</mode>
        <min-columns>1</min-columns>
        <max-columns>1</max-columns>
        <ask-for-group-id>false</ask-for-group-id>
        <clear-selection-first>true</clear-selection-first>
      </frame>
      <pick-from-list>
        <name>reference</name>
        <prompt>Which observer is a reference standard?</prompt>
        <include-none-entry>true</include-none-entry>
        <source>raters</source>
      </pick-from-list>
    </parameters>
    <builtin function-name="rptUniversalAgreement" />
    <report type="application/x-statsdirect-creole" filename="universalAgreement.creole" />
  </steps>
  <suggested-operations>
    <suggested-operation suggest-if='=null != parameters &amp;&amp; !(parameters.ContainsKey("reference") &amp;&amp; null != parameters["reference"])'>UniversalAgreementSimulateExactP</suggested-operation>
  </suggested-operations>
</operation>
