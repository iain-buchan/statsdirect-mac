<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Diversity</name>
	<friendly-name lang="en-GB">Analysis of diversity of classes</friendly-name>
  <help chm-id="1222" />
  <steps>
      <parameters>
        <confidence-interval>
          <name>gamma</name>
        </confidence-interval>
        <frame>
          <name>data</name>
          <prompt>Select DATA</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>200</max-columns>
          <ask-for-group-id>true</ask-for-group-id>
        </frame>
        <integer>
          <name>boots</name>
          <prompt>Bootstrap replications</prompt>
          <minimum-value>1</minimum-value>
          <default-value>10000</default-value>
        </integer>
      </parameters>
		<builtin function-name="rptDiversity" />
    <report type="application/x-statsdirect-creole" filename="diversity.creole" />
	</steps>
</operation>
