<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>FriedmanSimulateExactP</name>
	<friendly-name lang="en-GB">Friedman simulated exact P</friendly-name>
  <prerequisite-operation>Friedman</prerequisite-operation>
  <prerequisite-operation>CochranQ</prerequisite-operation>
  <help chm-id="1223" />
  <steps>
      <parameters>
        <integer>
          <name>iterations</name>
          <prompt>Iterations</prompt>
          <minimum-value>1</minimum-value>
          <default-value>100000</default-value>
          <must-request>true</must-request>
        </integer>
        <integer>
          <name>seed</name>
          <prompt>Seed</prompt>
          <default-value>=Base.DefaultSeed()</default-value>
          <force-default>true</force-default>
          <must-request>true</must-request>
        </integer>
        <confidence-interval>
          <name>ci</name>
          <default-value>0.99</default-value>
          <must-request>true</must-request>
          <can-default>false</can-default>
        </confidence-interval>
        <frame>
          <!-- Should already be present due to the prerequisite operation, but let's force the issue -->
          <name>data</name>
          <prompt>Select DATA</prompt>
          <same-length>true</same-length>
          <mode>NumericReplaceMissing</mode>
          <min-columns>2</min-columns>
          <max-columns>200</max-columns>
          <ask-for-group-id>true</ask-for-group-id>
        </frame>
      </parameters>
		<builtin function-name="rptFriedmanSimulateExactP" />
    <report type="application/x-statsdirect-creole" filename="simulatedExactP.creole" />
  </steps>
</operation>
