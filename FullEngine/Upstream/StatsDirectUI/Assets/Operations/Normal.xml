<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Normal</name>
	<friendly-name lang="en-GB">Normal scores</friendly-name>
  <help chm-id="1077" />
  <steps>
      <parameters>
        <frame>
          <name>data</name>
          <prompt>Select data for NORMAL SCORES</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
        </frame>
        <option>
          <name>method</name>
          <columns>2</columns>
          <prompt>Select score method</prompt>
          <default-value>vdW</default-value>
          <options>
            <option value="vdW">van der Waerden</option>
            <option value="Blom">Blom</option>
            <option value="EO">expected normal order</option>
          </options>
        </option>
      </parameters>
    <builtin function-name="shtNormal"/>
    <output-frame frame-name="output" />
	</steps>
</operation>
