<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Tabulate</name>
	<friendly-name lang="en-GB">Cross-tabulate two variables</friendly-name>
  <help chm-id="1089" />
  <steps>
      <parameters>
        <frame>
          <name>rows</name>
          <prompt>select data for FIRST CLASSIFIER (ROWS)</prompt>
          <mode>CategoryReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>columns</name>
          <prompt>select data for SECOND CLASSIFIER(S) (COLUMNS)</prompt>
          <mode>CategoryReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>100</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <boolean>
          <name>sorted</name>
          <prompt>Sort row and column categories in alphanumeric order?</prompt>
          <default-value>true</default-value>
        </boolean>
      </parameters>
    <builtin function-name="shtTabulate"/>
    <output-frame frame-name="output" />
	</steps>
</operation>
