<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>TextCode</name>
	<friendly-name lang="en-GB">Convert text to numbers</friendly-name>
  <help chm-id="1090" />
  <steps>
      <parameters>
        <frame>
          <name>data</name>
          <prompt>Select text data to CODE as numbers</prompt>
          <mode>Text</mode>
          <min-columns>1</min-columns>
          <max-columns>256</max-columns>
        </frame>
      </parameters>
      <parameters>
        <special>
          <name>data</name>
          <must-request>true</must-request>
          <type>textToNumbers</type>
        </special>
      </parameters>
    <output-frame frame-name="output" missing-indicator="" />
	</steps>
</operation>
