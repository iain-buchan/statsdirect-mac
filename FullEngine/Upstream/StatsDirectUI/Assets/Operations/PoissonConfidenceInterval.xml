<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>PoissonConfidenceInterval</name>
	<friendly-name lang="en-GB">Poisson rate confidence interval</friendly-name>
  <help chm-id="1238" />
  <steps>
      <parameters>
        <frame>
          <name>data</name>
          <prompt>Select data for POISSON ESTIMATES</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>200</max-columns>
          <ask-for-group-identifiers>true</ask-for-group-identifiers>
        </frame>
        <confidence-interval>
          <name>gamma</name>
        </confidence-interval>
      </parameters>
		<builtin function-name="rptPoissonConfidenceInterval" />
    <report type="application/x-statsdirect-creole" filename="poisson.creole" />
	</steps>
</operation>
