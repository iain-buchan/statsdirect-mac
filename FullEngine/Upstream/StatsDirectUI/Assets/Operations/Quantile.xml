<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Quantile</name>
  <friendly-name lang="en-GB">Calculation of quantiles (centiles)</friendly-name>
  <help chm-id="1230" />
  <steps>
      <parameters>
        <frame>
          <name>data</name>
          <prompt>Select DATA</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>200</max-columns>
          <ask-for-group-id>true</ask-for-group-id>
        </frame>
        <confidence-interval>
          <name>gamma</name>
          <must-request>true</must-request>
          <can-default>false</can-default>
        </confidence-interval>
        <boolean>
          <name>conservative-ci</name>
          <prompt>Conservative CI</prompt>
        </boolean>
        <double>
          <name>quantile</name>
          <prompt>Quantile to evaluate</prompt>
          <default-value>0.5</default-value>
          <minimum-value>0</minimum-value>
          <maximum-value>1</maximum-value>
        </double>
      </parameters>
		<builtin function-name="rptQuantile" />
    <report type="application/x-statsdirect-creole" filename="quantile.creole" />
	</steps>
</operation>
