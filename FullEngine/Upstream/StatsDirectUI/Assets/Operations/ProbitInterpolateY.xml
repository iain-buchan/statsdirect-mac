<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>ProbitInterpolateY</name>
	<friendly-name lang="en-GB">Interpolate Y to X</friendly-name>
  <prerequisite-operation>Logit</prerequisite-operation>
  <prerequisite-operation>Probit</prerequisite-operation>
  <steps>
      <parameters>
        <double>
          <name>newy</name>
          <prompt>Y from which to predict X</prompt>
          <must-request>true</must-request>
          <minimum-value>0</minimum-value>
          <maximum-value>1</maximum-value>
          <default-value>0.5</default-value>
        </double>
      </parameters>
		<builtin function-name="rptProbitInterpolateY" />
    <report type="application/x-statsdirect-creole" filename="intproby.creole" />
	</steps>
</operation>
