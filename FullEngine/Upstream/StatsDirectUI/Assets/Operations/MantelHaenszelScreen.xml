<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>MantelHaenszelScreen</name>
  <friendly-name lang="en-GB">Mantel-Haenszel test and odds ratio meta-analysis</friendly-name>
  <help chm-id="1167" />
  <steps>
      <parameters>
        <double-2-by-2-by-k>
          <name>data</name>
          <prompt/>
          <min-columns>2</min-columns>
          <max-columns>2</max-columns>
          <same-length>true</same-length>
          <mode>NumericReplaceMissing</mode>
          <must-request>true</must-request>
          <can-select>false</can-select>
        </double-2-by-2-by-k>
        <confidence-interval>
          <name>cco</name>
          <must-request>true</must-request>
        </confidence-interval>
        <boolean>
          <name>plot_forest</name>
          <prompt>Forest plot</prompt>
          <must-request>true</must-request>
          <column>2</column>
        </boolean>
        <boolean>
          <name>try_exact</name>
          <prompt>Try exact methods? (this occasionally takes a long time)</prompt>
          <must-request>true</must-request>
          <column>2</column>
        </boolean>
      </parameters>
  	<builtin function-name="rptChiMantel" />
    <report type="application/x-statsdirect-creole" filename="mantel.creole" />
    <report type="application/x-statsdirect-creole" filename="charts.creole" />
  </steps>
  <suggested-operations>
    <suggested-operation>MantelHaenszelScreen</suggested-operation>
  </suggested-operations>
</operation>
