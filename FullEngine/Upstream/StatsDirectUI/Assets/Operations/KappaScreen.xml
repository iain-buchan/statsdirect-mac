<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>KappaScreen</name>
  <friendly-name lang="en-GB">Measures of inter-rater agreement over categorization</friendly-name>
  <help chm-id="1003" />
  <steps>
      <parameters>
        <special>
          <name>responsesCrosstab</name>
          <must-request>true</must-request>
          <type>raters-2d</type>
        </special>
        <confidence-interval>
          <name>ci</name>
          <must-request>true</must-request>
        </confidence-interval>
        <option>
          <name>method</name>
          <prompt>Select method for weighted kappa</prompt>
          <column>2</column>
          <must-request>true</must-request>
          <default-value>1</default-value>
          <options>
            <option value="1">linear: 1-abs(i-j)/(1-k)</option>
            <option value="2">quadratic: 1-[(i-j)/(1-k)]&#178;</option>
            <option value="3">user defined</option>
          </options>
        </option>
        <boolean>
          <name>doExactP</name>
          <prompt>Simulate exact P?</prompt>
          <column>2</column>
          <must-request>true</must-request>
        </boolean>
        <integer>
          <name>iterations</name>
          <prompt>Iterations</prompt>
          <must-request>true</must-request>
          <column>2</column>
          <acquire-if-true>=parameters.ContainsKey("doExactP") &amp;&amp; parameters["doExactP"].AsBoolean</acquire-if-true>
          <minimum-value>1</minimum-value>
          <default-value>1000000</default-value>
        </integer>
        <integer>
          <name>seed</name>
          <prompt>Seed</prompt>
          <force-default>true</force-default>
          <must-request>true</must-request>
          <column>2</column>
          <acquire-if-true>=parameters.ContainsKey("doExactP") &amp;&amp; parameters["doExactP"].AsBoolean</acquire-if-true>
          <default-value>=Base.DefaultSeed()</default-value>
        </integer>
        <confidence-interval>
          <name>ci</name>
          <must-request>true</must-request>
          <acquire-if-true>=parameters.ContainsKey("doExactP") &amp;&amp; parameters["doExactP"].AsBoolean</acquire-if-true>
          <column>2</column>
          <can-default>false</can-default>
          <default-value>0.99</default-value>
          <can-use-standard>false</can-use-standard>
        </confidence-interval>
      </parameters>
    <test>
      <condition>="3".Equals(parameters["method"].AsString)</condition>
      <iftrue>
        <!-- Weights -->
          <parameters>
            <frame>
              <name>weights</name>
              <prompt>="Select table of WEIGHTS (" + parameters["responsesCrosstab"].AsDataFrame.MaxRows + " rows by " + parameters["responsesCrosstab"].AsDataFrame.VariableCount + " columns)"</prompt>
              <must-request>true</must-request>
              <length>=parameters["responsesCrosstab"].AsDataFrame.MaxRows</length>
              <mode>NumericReplaceMissing</mode>
              <min-columns>=parameters["responsesCrosstab"].AsDataFrame.VariableCount</min-columns>
              <max-columns>=parameters["responsesCrosstab"].AsDataFrame.VariableCount</max-columns>
              <clear-selection-first>true</clear-selection-first>
              <can-select>false</can-select>
              <validators>
                <validator><name>NoMissingData</name></validator>
                <validator><name>NonNegative</name></validator>
              </validators>
            </frame>
          </parameters>
      </iftrue>
    </test>
    <builtin function-name="rptKappaScreen" />
    <report type="application/x-statsdirect-creole" filename="kappa.creole"/>
    <test>
      <condition>=parameters.ContainsKey("doExactP") &amp;&amp; parameters["doExactP"].AsBoolean</condition>
      <iftrue>
        <builtin function-name="rptKappaSimulateExactP" />
        <report type="application/x-statsdirect-creole" filename="kappaSimulatedExactP.creole"/>
      </iftrue>
    </test>
	</steps>
  <suggested-operations>
    <suggested-operation>KappaScreen</suggested-operation>
  </suggested-operations>
</operation>
