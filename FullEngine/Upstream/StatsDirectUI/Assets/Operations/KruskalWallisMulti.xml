<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>KruskalWallisMulti</name>
	<friendly-name lang="en-GB">Kruskal-Wallis multiple comparisons</friendly-name>
  <help chm-id="1226" />
  <prerequisite-operation>Kruskal</prerequisite-operation>
  <steps>
      <parameters>
        <confidence-interval>
          <name>confidence</name>
        </confidence-interval>
        <frame>
          <name>data</name>
          <prompt>Select DATA</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>2</min-columns>
          <max-columns>200</max-columns>
          <ask-for-group-id>true</ask-for-group-id>
        </frame>
        <option>
          <name>sided</name>
          <prompt>One or two sided</prompt>
          <must-request>true</must-request>
          <options>
            <option value="1">1-sided</option>
            <option value="2">2-sided</option>
          </options>
          <default-value>2</default-value>
        </option>
      </parameters>
		<builtin function-name="rptKwMultiple" />
    <test>
      <condition>="one".Equals(parameters["sidedoutput"].AsString)</condition>
      <iftrue>
        <report type="application/x-statsdirect-creole" filename="kwmultionesided.creole" />
      </iftrue>
      <iffalse>
        <report type="application/x-statsdirect-creole" filename="kwmultitwosided.creole" />
      </iffalse>
    </test>
	</steps>
</operation>
