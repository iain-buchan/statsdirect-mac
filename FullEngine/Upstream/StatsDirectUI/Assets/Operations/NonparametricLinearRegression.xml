<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>NonparametricLinearRegression</name>
  <friendly-name lang="en-GB">Nonparametric linear regression</friendly-name>
  <help chm-id="1228" />
  <steps>
      <parameters>
        <confidence-interval>
          <name>gamma</name>
        </confidence-interval>
        <frame>
          <name>outcome</name>
          <prompt>Select data for OUTCOME (Y axis)</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <ask-for-group-id>false</ask-for-group-id>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>predictor</name>
          <prompt>Select data for PREDICTOR (X axis)</prompt>
          <same-length-as>outcome</same-length-as>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <ask-for-group-id>false</ask-for-group-id>
          <clear-selection-first>true</clear-selection-first>
        </frame>
      </parameters>
	<builtin function-name="rptNpRegression" copy-input-parameters="true" />
	<chart copy-input-parameters="true">
		<x-series-data>predictor</x-series-data>
		<y-series-data>outcome</y-series-data>
		<chart-name>chart</chart-name>
		<chart-type>LinearRegression</chart-type>
		<box-axes>false</box-axes>
		<chart-title>non-parametric linear regression plot</chart-title>
	</chart>
  <report type="application/x-statsdirect-creole" filename="nplinreg.creole" />
	</steps>
</operation>
