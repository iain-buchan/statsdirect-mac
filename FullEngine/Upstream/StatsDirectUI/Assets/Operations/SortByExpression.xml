<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>SortByExpression</name>
	<friendly-name lang="en-GB">Sort by expression</friendly-name>
  <help chm-id="1086" />
  <steps>
      <parameters>
        <frame>
          <name>data</name>
          <prompt>Select data for sorting</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>10</max-columns>
          <same-length>true</same-length>
        </frame>
        <string>
          <name>expression</name>
          <prompt>Enter the sort expression</prompt>
          <default-value>="=X1"</default-value>
        </string>
      </parameters>
    <builtin function-name="shtSortByExpression"/>
    <output-frame frame-name="output" />
  </steps>
</operation>
