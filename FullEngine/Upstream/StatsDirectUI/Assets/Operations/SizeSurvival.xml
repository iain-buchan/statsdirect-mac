<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>SizeSurvival</name>
  <friendly-name lang="en-GB">Sample size for comparing survival times</friendly-name>
  <help chm-id="1310" />
  <steps>
      <parameters>
        <double>
          <name>ct</name>
          <prompt>Median survival time in control group</prompt>
          <must-request>true</must-request>
        </double>
        <option>
          <name>time-or-hr</name>
          <prompt></prompt>
          <must-request>true</must-request>
          <default-value>time</default-value>
          <options>
            <option value="time">Two median survival times</option>
            <option value="hr">Control survival time and hazard ratio</option>
          </options>
        </option>
        <double>
          <name>et</name>
          <prompt>Median survival time in experimental group</prompt>
          <must-request>true</must-request>
          <acquire-if-true language="c#">=!(parameters.ContainsKey("time-or-hr") &amp;&amp; "hr".Equals(parameters["time-or-hr"].AsString))</acquire-if-true>
        </double>
        <double>
          <name>hr</name>
          <prompt>Hazard ratio (relative risk) for experimental subjects vs. controls</prompt>
          <must-request>true</must-request>
          <acquire-if-true language="c#">=parameters.ContainsKey("time-or-hr") &amp;&amp; "hr".Equals(parameters["time-or-hr"].AsString)</acquire-if-true>
        </double>
        <double>
          <name>at</name>
          <prompt>Accrual time during which subjects are recruited</prompt>
          <must-request>true</must-request>
        </double>
        <double>
          <name>fut</name>
          <prompt>Additional follow-up time after recruitment</prompt>
          <must-request>true</must-request>
        </double>
        <double>
          <name>m</name>
          <prompt>Number of controls per experimental subject</prompt>
          <must-request>true</must-request>
          <minimum-value>0</minimum-value>
          <default-value>1</default-value>
        </double>
        <confidence-interval>
          <name>p</name>
          <prompt>% POWER (% probability of correctly detecting a real effect)</prompt>
          <minimum-suggested-value>0.7</minimum-suggested-value>
          <maximum-suggested-value>0.95</maximum-suggested-value>
          <suggested-step>0.05</suggested-step>
          <default-value>0.8</default-value>
          <must-request>true</must-request>
          <can-default>false</can-default>
        </confidence-interval>
        <confidence-interval>
          <name>a</name>
          <prompt>% ALPHA (% probability of incorrectly rejecting the null hypothesis)</prompt>
          <minimum-suggested-value>0.001</minimum-suggested-value>
          <maximum-suggested-value>0.05</maximum-suggested-value>
          <suggested-step>0.001</suggested-step>
          <default-value>0.05</default-value>
          <must-request>true</must-request>
          <can-default>false</can-default>
        </confidence-interval>
      </parameters>
  	<builtin function-name="rptSizeSurvival" />
    <report type="application/x-statsdirect-creole" filename="s_survival.creole" />
  </steps>
  <suggested-operations>
    <suggested-operation>SizeSurvival</suggested-operation>
  </suggested-operations>
</operation>
