<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd" xsi:schemaLocation="http://www.statsdirect.com/schemas/Operation.xsd Operation.xsd">
	<name>AbridgedLifetable</name>
  <friendly-name lang="en-GB">Abridged (classical) life table analysis</friendly-name>
  <help chm-id="1320" />
  <steps>
      <parameters>
        <frame>
          <name>intervals</name>
          <prompt>Select data for age INTERVAL LENGTH</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>population</name>
          <prompt>Select data for mid-year POPULATION</prompt>
          <validators>
            <validator><name>Positive</name></validator>
          </validators>
          <length>=(parameters["intervals"].AsDataFrame.Variables[0] as DoubleVariable).Length + 1</length>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>deaths</name>
          <prompt>Select data for DEATHS in age interval</prompt>
          <length>=(parameters["intervals"].AsDataFrame.Variables[0] as DoubleVariable).Length + 1</length>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>fractions</name>
          <prompt>Select data for FRACTION of last age interval of life (skip if unknown)</prompt>
          <validators>
            <validator><name>ZeroToOneExclusive</name></validator>
          </validators>
          <cancel-skips-parameter>Skip</cancel-skips-parameter>
          <same-length-as>intervals</same-length-as>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>weights</name>
          <prompt>Select data for UTILITY WEIGHT for each interval (skip if not needed)</prompt>
          <cancel-skips-parameter>Skip</cancel-skips-parameter>
          <length>=(parameters["intervals"].AsDataFrame.Variables[0] as DoubleVariable).Length + 1</length>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <confidence-interval>
          <name>gamma</name>
        </confidence-interval>
        <boolean>
          <name>save</name>
          <prompt>Save details to worksheet</prompt>
        </boolean>
        <option>
          <name>iterations</name>
          <prompt>Iterations in simulation</prompt>
          <default-value>20000</default-value>
          <options>
            <option value="10000">10000</option>
            <option value="20000">20000</option>
            <option value="50000">50000</option>
            <option value="100000">100000</option>
            <option value="300000">300000</option>
          </options>
        </option>
      </parameters>
		<builtin function-name="rptAbridgedLifetable" />
		<test>
			<condition>=parameters.ContainsKey("results")</condition>
			<iftrue>
				<output-frame frame-name="results" />
			</iftrue>
		</test>
    <report type="application/x-statsdirect-creole" filename="abridged.creole" />
	</steps>
</operation>
