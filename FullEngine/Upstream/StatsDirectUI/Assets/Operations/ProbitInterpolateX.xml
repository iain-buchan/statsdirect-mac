<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>ProbitInterpolateX</name>
	<friendly-name lang="en-GB">Interpolate X to Y</friendly-name>
  <prerequisite-operation>Logit</prerequisite-operation>
  <prerequisite-operation>Probit</prerequisite-operation>
  <steps>
      <parameters>
        <double>
          <name>newx</name>
          <prompt>X from which to predict Y</prompt>
          <must-request>true</must-request>
          <minimum-value>0</minimum-value>
        </double>
      </parameters>
		<builtin function-name="rptProbitInterpolateX" />
    <report type="application/x-statsdirect-creole" filename="intprobx.creole" />
	</steps>
</operation>
