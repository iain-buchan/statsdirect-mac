<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>TPaired</name>
  <friendly-name lang="en-GB">Paired Student t test</friendly-name>
  <help chm-id="1239" />
	<steps>
      <parameters>
        <frame>
          <name>data</name>
          <prompt>Select 2 matched columns (or 1 of differences)</prompt>
          <same-length>true</same-length>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>2</max-columns>
          <ask-for-group-id>true</ask-for-group-id>
        </frame>
        <confidence-interval>
          <name>gamma</name>
          <lifetime>SessionForThisOperation</lifetime>
        </confidence-interval>
      </parameters>
    <test>
      <condition>=parameters["data"].AsDataFrame.VariableCount > 1</condition>
      <iftrue>
          <parameters>
            <boolean>
              <name>doAgreement</name>
              <prompt>Agreement analysis</prompt>
              <lifetime>SessionForThisOperation</lifetime>
            </boolean>
          </parameters>
      </iftrue>
    </test>
	  <builtin function-name="rptTPaired" />
    <report type="application/x-statsdirect-creole" filename="m_paired.creole" />
    <report type="application/x-statsdirect-creole" filename="charts.creole" />
  </steps>
  <tests>
    <test>
      <inputs>
        <parameter name="doAgreement">True</parameter>
        <parameter name="data">
          PEFR Before,PEFR After
          312,300
          242,201
          340,232
          388,312
          296,220
          254,256
          391,328
          402,330
          290,231
        </parameter>
        <parameter name="gamma">0.95</parameter>
      </inputs>
      <outputs>
        <output name="label">differences between PEFR Before and PEFR After</output>
        <output name="mean">56.111111111111114</output>
        <output name="n">9</output>
        <output name="sd">34.173982956499401</output>
        <output name="sem">11.391327652166467</output>
        <output name="pc">95</output>
        <output name="from">29.842662439749674</output>
        <output name="to">82.379559782472555</output>
        <output name="df">8</output>
        <output name="t">4.9257744860354</output>
        <output name="tail_1">0.00057778652567615273</output>
        <output name="tail_2">0.0011555730513523055</output>
        <output name="pwr">(for 5% significance) = 98.98%</output>
        <output name="*twosample$1$from2">-10.868664691913338</output>
        <output name="*twosample$1$to2">123.09088691413557</output>
      </outputs>
    </test>

  </tests>
</operation>
