<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
  <name>UnivariateSummaryToWorksheetOnly</name>
  <friendly-name lang="en-GB">Univariate descriptive summaries of variables</friendly-name>
  <help chm-id="1043" />
  <steps>
    <parameters>
      <frame>
        <name>data</name>
        <prompt>Select data to describe</prompt>
        <mode>NumericReplaceMissing</mode>
        <min-columns>1</min-columns>
        <max-columns>200</max-columns>
        <ask-for-group-id>true</ask-for-group-id>
      </frame>
      <confidence-interval>
        <name>gamma</name>
      </confidence-interval>
      <multiple-options>
        <prompt>Select the results to include in the report</prompt>
        <options>
          <option name="report-valid-data" selected="true">Valid data</option>
          <option name="report-missing-data" selected="true">Missing data</option>
          <option name="report-sum" selected="true">Sum</option>
          <option name="report-mean" selected="true">Mean</option>
          <option name="report-variance" selected="true">Variance</option>
          <option name="report-sd" selected="true">Standard deviation</option>
          <option name="report-variance-coeff" selected="true">Variance coefficient</option>
          <option name="report-sem" selected="true">Standard error of mean</option>
          <option name="report-u95cl" selected="true">Upper 95% CL of mean</option>
          <option name="report-l95cl" selected="true">Lower 95% CL of mean</option>
          <option name="report-geometric-mean" selected="true">Geometric mean</option>
          <option name="report-skewness" selected="true">Skewness</option>
          <option name="report-kurtosis" selected="true">Kurtosis</option>
          <option name="report-maximum" selected="true">Maximum</option>
          <option name="report-uq" selected="true">Upper quartile</option>
          <option name="report-median" selected="true">Median</option>
          <option name="report-lq" selected="true">Lower quartile</option>
          <option name="report-iqr" selected="true">Interquartile range</option>
          <option name="report-minimum" selected="true">Minimum</option>
          <option name="report-range" selected="true">Range</option>
          <option name="report-udc" selected="true">User defined centiles</option>
        </options>
      </multiple-options>
      <option>
        <name>report-centile-type</name>
        <default-value>1</default-value>
        <options>
          <option value="1">Centile type 1</option>
          <option value="2">Centile type 2</option>
        </options>
      </option>
      <confidence-interval>
        <name>report-udca</name>
        <prompt>User defined centile a</prompt>
        <minimum-suggested-value>0.01</minimum-suggested-value>
        <maximum-suggested-value>0.2</maximum-suggested-value>
        <suggested-step>0.01</suggested-step>
        <can-default>false</can-default>
        <default-value>0.05</default-value>
      </confidence-interval>
      <confidence-interval>
        <name>report-udcb</name>
        <prompt>User defined centile b</prompt>
        <minimum-suggested-value>0.8</minimum-suggested-value>
        <maximum-suggested-value>0.99</maximum-suggested-value>
        <suggested-step>0.01</suggested-step>
        <can-default>false</can-default>
        <default-value>0.95</default-value>
      </confidence-interval>
      <special>
        <name>statsdirect-frame-pane</name>
        <prompt>Pick the sheet in which you want the output to appear</prompt>
        <type>frame</type>
      </special>
    </parameters>
    <builtin function-name="rptUnivariateSummary" />
    <test>
      <condition>=parameters.ContainsKey("output")</condition>
      <iftrue>
        <output-frame frame-name="output" />
      </iftrue>
    </test>
  </steps>
</operation>
