<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
  <name>TSingle</name>
  <friendly-name lang="en-GB">Single sample Student t test</friendly-name>
  <help chm-id="1241" />
  <steps>
    <parameters>
      <frame>
        <name>data</name>
        <prompt>Select DATA</prompt>
        <mode>NumericReplaceMissing</mode>
        <min-columns>1</min-columns>
        <max-columns>1</max-columns>
        <ask-for-group-id>false</ask-for-group-id>
      </frame>
      <confidence-interval>
        <name>gamma</name>
        <lifetime>SessionForThisOperation</lifetime>
      </confidence-interval>
      <double>
        <name>population-mean</name>
        <prompt>Population mean</prompt>
        <must-request>true</must-request>
        <lifetime>SessionForThisOperation</lifetime>
        <default-value>0</default-value>
      </double>
    </parameters>
    <builtin function-name="rptTSingle" />
    <report type="application/x-statsdirect-creole" filename="m_single.creole" />
  </steps>
</operation>
