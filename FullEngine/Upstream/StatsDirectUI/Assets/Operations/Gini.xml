<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
  <name>Gini</name>
  <friendly-name lang="en-GB">Gini coefficient of inequality</friendly-name>
  <help chm-id="1224" />
  <steps>
    <parameters>
      <confidence-interval>
        <name>gamma</name>
      </confidence-interval>
      <frame>
        <name>data</name>
        <prompt>Select DATA</prompt>
        <mode>NumericReplaceMissing</mode>
        <min-columns>1</min-columns>
        <max-columns>200</max-columns>
        <ask-for-group-id>true</ask-for-group-id>
        <validators>
          <validator><name>NonNegative</name></validator>
        </validators>
        <clear-selection-first>true</clear-selection-first>
      </frame>
    </parameters>
    <test>
      <condition>=parameters["data"].AsDataFrame.VariableCount == 1</condition>
      <iftrue>
        <parameters>
          <frame>
            <name>weights</name>
            <prompt>Select FREQUENCY WEIGHTS (skip for equal weights)</prompt>
            <cancel-skips-parameter>Skip</cancel-skips-parameter>
            <mode>NumericReplaceMissing</mode>
            <min-columns>1</min-columns>
            <max-columns>200</max-columns>
            <ask-for-group-id>true</ask-for-group-id>
            <same-length-as>data</same-length-as>
            <validators>
              <validator><name>NonNegative</name></validator>
              <validator><name>Integer</name></validator>
            </validators>
            <clear-selection-first>true</clear-selection-first>
          </frame>
        </parameters>
      </iftrue>
    </test>
    <parameters>
      <integer>
        <name>boots</name>
        <prompt>Bootstrap replications</prompt>
        <minimum-value>1</minimum-value>
        <default-value>100000</default-value>
      </integer>
    </parameters>
    <builtin function-name="rptGini" />
    <test>
      <condition>=parameters["data"].AsDataFrame.VariableCount == 1</condition>
      <iftrue>
        <chart>
          <x-series-data>X</x-series-data>
          <y-series-data>Y</y-series-data>
          <chart-name>chart</chart-name>
          <x-axis-title>Proportion of sample</x-axis-title>
          <y-axis-title>Proportion of variable</y-axis-title>
          <chart-type>Gini</chart-type>
          <box-axes>false</box-axes>
        </chart>
      </iftrue>
    </test>
    <report type="application/x-statsdirect-creole" filename="gini.creole" />
  </steps>
</operation>
