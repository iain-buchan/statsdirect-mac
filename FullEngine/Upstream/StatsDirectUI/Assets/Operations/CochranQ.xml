<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>CochranQ</name>
	<friendly-name lang="en-GB">Cochran Q test</friendly-name>
  <help chm-id="1223" />
  <steps>
      <parameters>
        <frame>
          <name>data</name>
          <prompt>Select DATA</prompt>
          <same-length>true</same-length>
          <mode>NumericReplaceMissing</mode>
          <min-columns>2</min-columns>
          <max-columns>200</max-columns>
          <ask-for-group-id>true</ask-for-group-id>
        </frame>
      </parameters>
		<builtin function-name="rptFriedman" />
    <test>
      <condition>="Friedman".Equals(parameters["testName"].AsString)</condition>
      <iftrue>
        <report type="application/x-statsdirect-creole" filename="friedman.creole" />
      </iftrue>
      <iffalse>
        <report type="application/x-statsdirect-creole" filename="cochranq.creole" />
      </iffalse>
    </test>
	</steps>
  <suggested-operations>
    <suggested-operation>FriedmanSimulateExactP</suggested-operation>
  </suggested-operations>
</operation>
