<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>HistogramPlot</name>
  <friendly-name lang="en-GB">Histogram plot</friendly-name>
  <help chm-id="1125" />
  <steps>
      <parameters>
        <frame>
          <name>data</name>
          <title>Histogram data</title>
          <prompt>Select data for Histogram</prompt>
          <mode>NumericSkipMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>100</max-columns>
        </frame>
      </parameters>
		<chart>
			<y-series-data>data</y-series-data>
			<chart-name>chart</chart-name>
			<chart-type>Histogram</chart-type>
			<box-axes>false</box-axes>
		</chart>
    <report type="application/x-statsdirect-creole" filename="chartonly.creole" />
	</steps>
</operation>
