<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>LinearizedEstimateInterpolation</name>
	<friendly-name lang="en-GB">Interpolate X to Y</friendly-name>
  <prerequisite-operation>LinearizedEstimates</prerequisite-operation>
  <steps>
      <parameters>
        <frame>
          <name>y</name>
          <prompt>Select data for OUTCOME (Y axis)</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>x</name>
          <prompt>Select data for PREDICTOR (X axis)</prompt>
          <mode>NumericReplaceMissing</mode>
          <same-length-as>y</same-length-as>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <double>
          <name>newx</name>
          <prompt>New X value</prompt>
          <must-request>true</must-request>
        </double>
      </parameters>
		<builtin function-name="rptLinearizedEstimateInterpolation" />
    <report type="application/x-statsdirect-creole" filename="interlin.creole" />
	</steps>
</operation>
