<report>
<block name="a">
<title>Two way randomized block analysis of variance for @variableName</title>

<p>Treatments: @tlist</p>

<table>
<tr><th>Source of Variation</th><th>Sum Squares</th><th>DF</th><th>Mean Square</th></tr>
<tr><td>Between blocks (rows)</td><td>@{sub_sum:roundu}</td><td>@sub_df</td><td>@{sub_mean:roundu}</td></tr>
<tr><td>Between treatments (columns)</td><td>@{grp_sum:roundu}</td><td>@grp_df</td><td>@{grp_mean:roundu}</td></tr>
<tr><td>Residual (error)</td><td>@{res_sum:roundu}</td><td>@res_df</td><td>@{res_mean:roundu}</td></tr>
<tr><td>Corrected total</td><td>@{tot_sum:roundu}</td><td>@tot_df</td></tr>
</table>

<p>F (VR between blocks) = @{sub_vr:roundu}  <pval>@{sub_p:pval}</pval></p>

<p>F (VR between treatments) = @{grp_vr:roundu}  <pval>@{grp_p:pval}</pval></p>

<br />
</block>
</report>
