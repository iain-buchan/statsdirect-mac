<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>MetaIncidenceRateRatio</name>
  <friendly-name lang="en-GB">Meta-analysis of incidence rate ratios</friendly-name>
  <help chm-id="1163" />
  <steps>
      <parameters>
        <confidence-interval>
          <name>gamma</name>
        </confidence-interval>
        <frame>
          <name>pt1</name>
          <prompt>Select PERSON-TIME for EXPOSED groups</prompt>
          <same-length-as>a</same-length-as>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>a</name>
          <prompt>Select numbers of CASES in EXPOSED groups</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>pt2</name>
          <prompt>Select PERSON-TIME for NON-EXPOSED groups</prompt>
          <same-length-as>a</same-length-as>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>b</name>
          <prompt>Select number of CASES in NON-EXPOSED groups</prompt>
          <same-length-as>a</same-length-as>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>strata</name>
          <prompt>Select stratum LABELS [Default for default]</prompt>
          <cancel-skips-parameter>Default</cancel-skips-parameter>
          <same-length-as>a</same-length-as>
          <mode>Text</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
      </parameters>
		<builtin function-name="rptMetaIncidenceRateRatio" />
    <report type="application/x-statsdirect-creole" filename="irrmeta.creole" />
    <report type="application/x-statsdirect-creole" filename="charts.creole" />
	</steps>
</operation>
