<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>LogisticRegressionBootstrap</name>
	<friendly-name lang="en-GB">Bootstrap</friendly-name>
  <prerequisite-operation>LogisticRegression</prerequisite-operation>
  <steps>
      <parameters>
        <integer>
          <name>boots</name>
          <prompt>How many bootstrap iterations?</prompt>
          <default-value>1000</default-value>
          <minimum-value>1</minimum-value>
        </integer>
        <confidence-interval>
          <name>gamma</name>
        </confidence-interval>
      </parameters>
		<builtin function-name="rptLogisticRegressionBootstrap" />
    <report type="application/x-statsdirect-creole">
      <![CDATA[<report>
<title>Logistic regression - bootstrap odds ratio estimates</title>

<p>Resampled @boots times@{warn}.</p>

<table>
<tr><th>Parameter</th><th>Observed OR</th><th>Bias</th><th>@{pc:round2}% bias-corrected CI</th></tr>
<block name="parameters"><tr><td>@par</td><td>@{obs:roundu}</td><td>@{bias:roundu}</td><td><ci>@{lci:roundu}  to  @{uci:roundu}</ci></td></tr></block>
</table>
</report>]]>
    </report>
  </steps>
</operation>
