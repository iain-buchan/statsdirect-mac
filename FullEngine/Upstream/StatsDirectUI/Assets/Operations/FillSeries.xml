<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>FillSeries</name>
  <friendly-name lang="en-GB">Fill series</friendly-name>
  <help chm-id="1071" />
  <steps>
      <parameters>
        <integer>
          <name>rows</name>
          <prompt>Length</prompt>
          <minimum-value>1</minimum-value>
          <default-value>100</default-value>
        </integer>
        <double>
          <name>startval</name>
          <prompt>Start value</prompt>
          <default-value>1</default-value>
        </double>
        <string>
          <name>formula</name>
          <prompt>Formula (X is previous value)</prompt>
          <default-value>X+1</default-value>
        </string>
        <string>
          <name>title</name>
          <prompt>Title</prompt>
        </string>
      </parameters>
  	<builtin function-name="shtFillSeries" />
	  <output-frame frame-name="output" />
	</steps>
</operation>
