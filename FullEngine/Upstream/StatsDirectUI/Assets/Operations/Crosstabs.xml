<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Crosstabs</name>
	<friendly-name lang="en-GB">Cross-tabulate variables and analyse the tables</friendly-name>
  <help chm-id="1042" />
  <steps>
      <parameters>
        <frame>
          <name>c1</name>
          <prompt>Select data for FIRST CLASSIFIER (ROWS)</prompt>
          <mode>CategoryReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>c2</name>
          <prompt>Select data for SECOND CLASSIFIER(S) (COLUMNS)</prompt>
          <mode>CategoryReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>100</max-columns>
          <clear-selection-first>true</clear-selection-first>
          <same-length-as>c1</same-length-as>
        </frame>
      </parameters>
    <test>
      <condition>=parameters["c2"].AsDataFrame.VariableCount == 1</condition>
      <iftrue>
          <parameters>
            <frame>
              <name>c3</name>
              <prompt>Select data for THIRD CLASSIFIER (STRATA) [skip if none]</prompt>
              <cancel-skips-parameter>Skip</cancel-skips-parameter>
              <mode>CategoryReplaceMissing</mode>
              <min-columns>1</min-columns>
              <max-columns>1</max-columns>
              <clear-selection-first>true</clear-selection-first>
              <same-length-as>c1</same-length-as>
            </frame>
          </parameters>
      </iftrue>
    </test>
    <test>
      <condition>=parameters.ContainsKey("c3")</condition>
      <iffalse>
          <parameters>
            <boolean>
              <name>doExact</name>
              <prompt>Try Fisher-Freeman-Halton exact test</prompt>
              <must-request>true</must-request>
              <default-value>true</default-value>
            </boolean>
            <boolean>
              <name>show_pc</name>
              <prompt>Show percentages</prompt>
              <must-request>true</must-request>
              <default-value>true</default-value>
            </boolean>
            <boolean>
              <name>xp</name>
              <prompt>Show expected counts</prompt>
              <must-request>true</must-request>
              <default-value>false</default-value>
            </boolean>
            <boolean>
              <name>cs</name>
              <prompt>Show cell chi-square</prompt>
              <must-request>true</must-request>
              <default-value>false</default-value>
            </boolean>
            <boolean>
              <name>xs</name>
              <prompt>Show trend scores</prompt>
              <must-request>true</must-request>
              <default-value>false</default-value>
            </boolean>
            <boolean>
              <name>specify_scores</name>
              <prompt>Specify trend scores</prompt>
              <must-request>true</must-request>
              <default-value>false</default-value>
            </boolean>
            <boolean>
              <name>doMonteCarlo</name>
              <prompt>Simulate exact P for chi-square</prompt>
              <must-request>true</must-request>
              <default-value>false</default-value>
            </boolean>
            <integer>
              <name>iterations</name>
              <prompt>Iterations</prompt>
              <acquire-if-true>=parameters.ContainsKey("doMonteCarlo") &amp;&amp; parameters["doMonteCarlo"].AsBoolean</acquire-if-true>
              <column>2</column>
              <must-request>true</must-request>
              <minimum-value>1</minimum-value>
              <default-value>1000000</default-value>
            </integer>
            <integer>
              <name>seed</name>
              <prompt>Seed</prompt>
              <acquire-if-true>=parameters.ContainsKey("doMonteCarlo") &amp;&amp; parameters["doMonteCarlo"].AsBoolean</acquire-if-true>
              <column>2</column>
              <must-request>true</must-request>
              <force-default>true</force-default>
              <default-value>=Base.DefaultSeed()</default-value>
            </integer>
            <confidence-interval>
              <name>ci</name>
              <acquire-if-true>=parameters.ContainsKey("doMonteCarlo") &amp;&amp; parameters["doMonteCarlo"].AsBoolean</acquire-if-true>
              <column>2</column>
              <must-request>true</must-request>
              <default-value>0.99</default-value>
              <can-default>false</can-default>
              <can-use-standard>false</can-use-standard>
            </confidence-interval>
          </parameters>
      </iffalse>
    </test>
    <parameters>
      <confidence-interval>
        <name>cco</name>
      </confidence-interval>
    </parameters>
    <builtin function-name="rptCrosstabsPreprocess" />
    <test>
      <condition>=parameters["strat"].AsBoolean</condition>
      <iftrue>
        <test>
          <condition>=parameters["xcats"].AsInt32 == 2 &amp;&amp; parameters["ycats"].AsInt32 == 2</condition>
          <iftrue>
              <parameters>
                <option>
                  <name>study_type</name>
                  <prompt>Which type of study produced your data?</prompt>
                  <options>
                    <option value="casecontrol">Case-control study</option>
                    <option value="cohort">Cohort study</option>
                    <option value="neither">Neither</option>
                  </options>
                  <default-value>casecontrol</default-value>
                </option>
              </parameters>
          </iftrue>
          <iffalse>
              <parameters>
                <special>
                  <type>scores</type>
                </special>
              </parameters>
          </iffalse>
        </test>
      </iftrue>
    </test>
    <builtin function-name="rptCrosstabs" />
    <report type="application/x-statsdirect-creole" filename="xtabouter.creole" />
  </steps>
</operation>
