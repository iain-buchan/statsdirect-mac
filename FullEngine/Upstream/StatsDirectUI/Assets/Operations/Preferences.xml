<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Preferences</name>
  <friendly-name lang="en-GB">Random allocation guided by group preference</friendly-name>
  <help chm-id="1253" />
  <steps>
      <parameters>
        <integer>
          <name>seed</name>
          <prompt>Seed for random number generator</prompt>
          <default-value>=Base.DefaultSeed()</default-value>
        </integer>
        <frame>
          <name>capacities</name>
          <prompt>Select column for group capacities</prompt>
          <mode>NumericSkipMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>preferences</name>
          <prompt>Select columns for preferences</prompt>
          <mode>NumericReplaceMissing</mode>
          <same-length>true</same-length>
          <min-columns>1</min-columns>
          <max-columns>200</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
      </parameters>
		<builtin function-name="rptPreferences" />
    <report type="application/x-statsdirect-creole" filename="prefer.creole" />
	</steps>
</operation>
