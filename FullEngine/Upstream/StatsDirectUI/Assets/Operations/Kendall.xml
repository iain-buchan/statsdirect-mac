<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Kendall</name>
  <friendly-name lang="en-GB">Kendall's rank correlation</friendly-name>
  <help chm-id="1225" />
  <steps>
      <parameters>
        <confidence-interval>
          <name>gamma</name>
        </confidence-interval>
        <frame>
          <name>data</name>
          <prompt>Select 2 columns for correlation</prompt>
          <same-length>true</same-length>
          <mode>NumericReplaceMissing</mode>
          <min-columns>2</min-columns>
          <max-columns>2</max-columns>
          <ask-for-group-id>true</ask-for-group-id>
        </frame>
      </parameters>
	<builtin function-name="rptKendall" />
  <report type="application/x-statsdirect-creole" filename="kendall.creole" />
	</steps>
</operation>
