<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>CoxResiduals</name>
	<friendly-name lang="en-GB">Residuals and diagnostics</friendly-name>
  <prerequisite-operation>CoxRegression</prerequisite-operation>
  <steps>
      <parameters>
        <boolean>
          <name>save</name>
          <prompt>Save values to worksheet?</prompt>
          <default-value>false</default-value>
          <must-request>true</must-request>
        </boolean>
      </parameters>
		<builtin function-name="rptCoxResiduals" />
		<test>
			<condition>=parameters.ContainsKey("results")</condition>
			<iftrue>
				<output-frame frame-name="results" />
			</iftrue>
		</test>
    <report type="application/x-statsdirect-creole" filename="charts.creole" />
	</steps>
</operation>
