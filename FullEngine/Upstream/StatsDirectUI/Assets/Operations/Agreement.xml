<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Agreement</name>
  <friendly-name lang="en-GB">General analysis of agreement</friendly-name>
  <help chm-id="1002" />
  <steps>
	<parameters>
		<frame>
			<name>data</name>
			<prompt>Select DATA</prompt>
			<same-length>true</same-length>
			<mode>NumericReplaceMissing</mode>
			<min-columns>2</min-columns>
			<max-columns>200</max-columns>
			<ask-for-group-id>true</ask-for-group-id>
		</frame>
		<confidence-interval>
			<name>ci</name>
		</confidence-interval>
	</parameters>
	<builtin function-name="rptAgreement" />
	<chart>
		<y-series-data>ssd</y-series-data>
		<x-series-data>av</x-series-data>
		<chart-name>repeatability</chart-name>
		<chart-type>ScatterXY</chart-type>
		<chart-title>Repeatability Plot</chart-title>
		<x-axis-title>subject mean</x-axis-title>
		<y-axis-title>subject standard deviation</y-axis-title>
    <request-user-input>false</request-user-input>
	</chart>
	<chart>
		<y-series-data>mxd</y-series-data>
		<x-series-data>av</x-series-data>
		<chart-name>agreement</chart-name>
		<chart-type>AgreementPair</chart-type>
    <x-axis-title>=(parameters["data"].AsDataFrame.VariableCount == 2) ? ("Mean ((" + parameters["data"].AsDataFrame.Variables[0].Title + " + " + parameters["data"].AsDataFrame.Variables[1].Title + ") / 2)") : null</x-axis-title>
    <y-axis-title>=(parameters["data"].AsDataFrame.VariableCount == 2) ? ("Difference (" + parameters["data"].AsDataFrame.Variables[0].Title + " - " + parameters["data"].AsDataFrame.Variables[1].Title + ")") : null</y-axis-title>
    <request-user-input>false</request-user-input>
  </chart>
	<chart>
		<y-series-data>xxm</y-series-data>
		<x-series-data>pvalues</x-series-data>
		<chart-name>qq</chart-name>
		<chart-type>ScatterXY</chart-type>
		<chart-title>Q-Q Plot</chart-title>
		<x-axis-title>=string.Format("chi-square ({0})", parameters["df"].AsDouble)</x-axis-title>
		<y-axis-title>Sum(|x-mean(x)|)</y-axis-title>
    <request-user-input>false</request-user-input>
  </chart>
  <report type="application/x-statsdirect-creole" filename="agree.creole" />
	</steps>
</operation>
