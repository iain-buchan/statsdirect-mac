<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>PoissonRegressionFitToReport</name>
	<friendly-name lang="en-GB">Fits and residuals</friendly-name>
  <prerequisite-operation>PoissonRegression</prerequisite-operation>
  <steps>
		<builtin function-name="rptPoissonRegressionFit" />
    <report type="application/x-statsdirect-creole">
      <![CDATA[<report>
<title>Poisson regression - fits and residuals</title>
<table>
<tr><th>Index</th><block name="predictors"><th>@lab</th></block></tr>
<block name="predictorValues"><tr><td>@idx</td><block name="pred"><td>@val</td></block></tr></block>
</table>

<table>
<tr><th>Index</th><th>Observed Events</th><th>Expected Events</th><th>Observed Incidence</th><th>Expected Incidence</th></tr>
<block name="events"><tr><td>@idx</td><td>@{obs:roundu}</td><td>@{fit:roundu}</td><td>@{iro:roundu}</td><td>@{ire:roundu}</td></tr></block>
</table>

<table>
<tr><th>Index</th><th>Residual (score)</th><th>Freeman-Tukey Residual</th><th>Deviance Residual</th></tr>
<block name="residuals"><tr><td>@idx</td><td>@{yr:roundu}</td><td>@{ftr:roundu}</td><td>@{dev:roundu}</td></tr></block>
</table>

<table>
<tr><th>Index</th><th>Pearson Chi&#xb2;</th><th>Leverage</th><th>Std Pearson Residual</th></tr>
<block name="pearson"><tr><td>@idx</td><td>@{res:roundu}</td><td>@{lev:roundu}</td><td>@{sres}</td></tr></block>
</table>

<table>
<tr><th>Parameters</th><th>Covariance</th></tr>
<block name="covar"><tr><td>@labi vs. @labj</td><td>@{cov:roundu}</td></tr></block>
</table>
</report>]]>
    </report>
  </steps>
</operation>
