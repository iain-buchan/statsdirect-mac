<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>MetaCorrelation</name>
  <friendly-name lang="en-GB">Meta-analysis of correlation coefficients</friendly-name>
  <help chm-id="1159" />
  <steps>
      <parameters>
        <confidence-interval>
          <name>gamma</name>
        </confidence-interval>
        <frame>
          <name>r</name>
          <prompt>Select CORRELATION COEFFICIENT (r)</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>n</name>
          <prompt>Select SAMPLE SIZE (n)</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <same-length-as>r</same-length-as>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>studies</name>
          <prompt>Select STUDY NAMES (Default for default)</prompt>
          <cancel-skips-parameter>Default</cancel-skips-parameter>
          <mode>Text</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <same-length-as>r</same-length-as>
          <clear-selection-first>true</clear-selection-first>
        </frame>
      </parameters>
		<builtin function-name="rptMetaCorrelation" />
    <report type="application/x-statsdirect-creole" filename="metaCorrelation.creole" />
    <report type="application/x-statsdirect-creole" filename="charts.creole" />
	</steps>
</operation>
