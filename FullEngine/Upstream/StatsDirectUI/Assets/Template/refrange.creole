<report>
<title>Reference range/interval</title>
<table>
<tr><td>Sample name:</td><td>@name</td></tr>
<tr><td>Sample mean =</td><td>@{mean:roundu}</td></tr>
<tr><td>Sample size n =</td><td>@size</td></tr>
<tr><td>Sample sd =</td><td>@{sd:roundu}</td></tr>
</table>

<p><u>For normal data</u><br />
@{qrr:round2}% reference interval = @{lrr:roundu} to @{urr:roundu}<br />
<ci>@{pc:round2}% confidence interval for lower range limit = @{lx_l:roundu} to @{ux_l:roundu}</ci><br />
<ci>@{pc:round2}% confidence interval for upper range limit = @{lx_u:roundu} to @{ux_u:roundu}</ci></p>
<block name="lognormal">

<p><u>For log-normal data</u><br />
@{qrr:round2}% reference interval = @{lrr_lognormal:roundu} to @{urr_lognormal:roundu}<br />
<ci>@{pc:round2}% confidence interval for lower range limit = @{lx_l_lognormal:roundu} to @{ux_l_lognormal:roundu}</ci><br />
<ci>@{pc:round2}% confidence interval for upper range limit = @{lx_u_lognormal:roundu} to @{ux_u_lognormal:roundu}</ci></p>
</block>

<p><u>For any data</u><br />
Quantile @{qx_any:roundu} = @{qxv_any:roundu}<br />
<ci>Approximate @{pc:round2}% confidence interval @type = @cap_from_any@{from_any:roundu} to @cap_to_any@{to_any:roundu}</ci><br />
Exact confidence level = @{co_any:roundu}%@cap_co_any</p>

<p>Quantile @{qx:roundu} = @{qxv:roundu}<br />
<ci>Approximate @{pc:round2}% confidence interval @type = @cap_from@{from:roundu} to @cap_to@{to:roundu}</ci><br />
Exact confidence level = @{co:roundu}%@cap_co</p>
</report>
