<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>MultipleLinearRegressionBestSubset</name>
	<friendly-name lang="en-GB">Best sub-set</friendly-name>
  <help chm-id="1277" />
  <prerequisite-operation>MultipleLinearRegression</prerequisite-operation>
  <steps>
			<parameters>
				<pick-from-list>
					<name>selectedPredictors</name>
          <prompt>Select predictors that must be kept</prompt>
          <must-request>true</must-request>
          <allow-multiple>true</allow-multiple>
          <source>predictorTitles</source>
				</pick-from-list>
				<option>
					<name>selector</name>
					<prompt>Selection method</prompt>
					<must-request>true</must-request>
          <default-value>minimumMallows</default-value>
					<options>
						<option value="minimumMallows">Minimum Mallows' CP</option>
						<option value="maximumF">Maximum overall F</option>
					</options>
				</option>
			</parameters>
		<builtin function-name="rptMultipleLinearRegressionBestSubset" />
    <report type="application/x-statsdirect-creole" filename="subset.creole" />
    <test>
			<condition>=parameters.ContainsKey("subsetApplied") &amp;&amp; parameters["subsetApplied"].AsBoolean</condition>
			<iftrue>
        <report type="application/x-statsdirect-creole" filename="multi.creole" />
      </iftrue>
		</test>
	</steps>
</operation>
