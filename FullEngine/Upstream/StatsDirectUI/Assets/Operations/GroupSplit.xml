<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>GroupSplit</name>
	<friendly-name lang="en-GB">Split a combined variable into its component variables</friendly-name>
  <help chm-id="1073" />
  <steps>
      <parameters>
        <frame>
          <name>gids</name>
          <prompt>Select GROUP IDENTIFIERS</prompt>
          <mode>CategoryReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>data</name>
          <prompt>Select data to SPLIT BY GROUP</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>200</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
      </parameters>
    <builtin function-name="shtGroupSplit"/>
      <parameters>
        <special>
          <prompt>="Number of groups = " + parameters["ng"].AsInt32.ToString()</prompt>
          <type>rubric</type>
        </special>
      </parameters>
    <output-frame frame-name="output" />
	</steps>
</operation>
