<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
  <name>ZUnpaired</name>
  <friendly-name lang="en-GB">Unpaired two-sample z(normal distribution) test</friendly-name>
  <help chm-id="1245" />
  <steps>
    <parameters>
      <confidence-interval>
        <name>gamma</name>
      </confidence-interval>
      <frame>
        <name>data</name>
        <prompt>Select DATA</prompt>
        <mode>NumericReplaceMissing</mode>
        <min-columns>2</min-columns>
        <max-columns>2</max-columns>
        <ask-for-group-id>true</ask-for-group-id>
      </frame>
    </parameters>
    <builtin function-name="rptZUnpaired" />
    <report type="application/x-statsdirect-creole" filename="z_norm2.creole" />
  </steps>
</operation>
