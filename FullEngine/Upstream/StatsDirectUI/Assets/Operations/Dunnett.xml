<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Dunnett</name>
	<friendly-name lang="en-GB">Dunnett comparisons (control)</friendly-name>
  <prerequisite-operation>OneWay</prerequisite-operation>
  <prerequisite-operation>ReplicateTwoWay</prerequisite-operation>
  <prerequisite-operation>TwoWay</prerequisite-operation>
  <steps>
      <parameters>
        <frame>
          <name>data</name>
          <prompt>Select DATA</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>2</min-columns>
          <max-columns>200</max-columns>
          <ask-for-group-id>true</ask-for-group-id>
        </frame>
        <confidence-interval>
          <name>gamma</name>
        </confidence-interval>
        <pick-variables>
          <name>indexvariable</name>
          <must-request>true</must-request>
          <parameter-name>data</parameter-name>
          <minimum-variables>1</minimum-variables>
          <maximum-variables>1</maximum-variables>
          <preselect-variables>true</preselect-variables>
          <label-as>Control</label-as>
        </pick-variables>
      </parameters>
		<builtin function-name="rptDunnett" />
    <report type="application/x-statsdirect-creole" filename="dunnett.creole" />
	</steps>
</operation>
