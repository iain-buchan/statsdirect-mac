<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>GroupedCovariance</name>
  <friendly-name lang="en-GB">Analysis of covariance</friendly-name>
  <help chm-id="1272" />
  <steps>
    <parameters>
      <grouped-covariance>
        <name>gcd</name>
      </grouped-covariance>
    </parameters>
    <!-- Calculate mx0 and prompt for an alternative value if the user wishes to override -->
    <builtin function-name="rptGroupedCovariancePreprocess" />
    <parameters>
      <double>
        <name>mx0-prompted</name>
        <prompt>Enter basline mean for predictors (default is the overall mean of predictor values)</prompt>
        <must-request>true</must-request>
        <default-value>=parameters["mx0"].AsDouble</default-value>
      </double>
    </parameters>
    <builtin function-name="rptGroupedCovariance" />
    <report type="application/x-statsdirect-creole" filename="grpcov.creole" />
	</steps>
</operation>
