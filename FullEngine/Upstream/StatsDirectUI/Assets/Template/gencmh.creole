<report>
<title>Generalised Cochran-Mantel-Haenszel tests</title>
<table>
<tr><td>Row variable (first classifier):</td><td><b><grandtotal>@ylab</grandtotal></b></td></tr>
<tr><td>Column variable (second classifier):</td><td><b><ci>@xlab</ci></b></td></tr>
<tr><td>Stratum variable (third classifier, controlling for):</td><td><b><subtotal>@zlab</subtotal></b></td></tr>
</table>

<p>@ylab scores: @rscore<br />
@xlab scores: @cscore</p>

<table>
<tr><th>Alternative hypothesis</th><th>Statistic</th><th>DF</th><th>Probability</th></tr>
<tr><td>Ordinal association</td><td>@{x21:roundu}</td><td>@{df1:round0}</td><td><pval>@{p1:pval}</pval></td></tr>
<tr><td>Nominal rows vs. ordinal columns association</td><td>@{x22:roundu}</td><td>@{df2:round0}</td><td><pval>@{p2:pval}</pval></td></tr>
<tr><td>Nominal association</td><td>@{x23:roundu}</td><td>@{df3:round0}</td><td><pval>@{p3:pval}</pval></td></tr>
</table>

<p>Sample size = @{nt:round0}</p>
</report>
