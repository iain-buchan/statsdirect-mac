<report>
<title>Follow-up life table</title>
<table>
<tr><th>Interval</th><th>Deaths</th><th>Withdrawn</th><th>At risk</th><th>Adj. at risk</th><th>P(death)</th></tr>
<block name="deaths"><tr><td>@int</td><td>@death</td><td>@wdrawn</td><td>@risk</td><td>@{nx:roundu}</td><td>@{q:roundu}</td></tr></block>
</table>

<table>
<tr><th>Interval</th><th>P(survival)</th><th>Survivors (l<sub>x</sub>%)</th><th>SD of l<sub>x</sub>%</th><th><ci>@{pc:round2}% CI for l<sub>x</sub>%</ci></th></tr>
<block name="survival"><tr><td>@int</td><td>@{p:roundu}</td><td>@{lx:roundu}</td><td>@{var:roundu}</td><td><ci>@{lci:roundu}  to  @{uci:roundu}</ci></td></tr></block>
</table>
</report>
