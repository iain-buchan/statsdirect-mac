<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>DummyVariables</name>
	<friendly-name lang="en-GB">Create dummy (indicator) variables</friendly-name>
  <help chm-id="1068" />
  <steps>
      <parameters>
        <frame>
          <name>data</name>
          <prompt>Select CATEGORICAL DATA column</prompt>
          <same-length>true</same-length>
          <mode>CategoryReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
        </frame>
      </parameters>
    <builtin function-name="shtDummyVariables" />
    <output-frame frame-name="output" />
	</steps>
</operation>
