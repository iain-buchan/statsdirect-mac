<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Stdrr</name>
  <friendly-name lang="en-GB">Standardize and compare two rates</friendly-name>
  <help chm-id="1266" />
	<steps>
      <parameters>
        <confidence-interval>
          <name>cco</name>
        </confidence-interval>
        <frame>
          <name>a</name>
          <prompt>Select numbers of EVENTS in the EXPOSED INDEX population</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>pt1</name>
          <prompt>Select PERSON-TIME for the EXPOSED INDEX population</prompt>
          <mode>NumericReplaceMissing</mode>
          <same-length-as>events</same-length-as>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>b</name>
          <prompt>Select numbers of EVENTS in the NON-EXPOSED INDEX population</prompt>
          <mode>NumericReplaceMissing</mode>
          <same-length-as>events</same-length-as>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>pt2</name>
          <prompt>Select PERSON-TIME for the NON-EXPOSED INDEX population</prompt>
          <mode>NumericReplaceMissing</mode>
          <same-length-as>events</same-length-as>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>ref</name>
          <prompt>Select stratum/group SIZES for the REFERENCE population</prompt>
          <mode>NumericReplaceMissing</mode>
          <same-length-as>events</same-length-as>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>strata</name>
          <prompt>Select standardization group LABELS [Default for default]</prompt>
          <cancel-skips-parameter>Default</cancel-skips-parameter>
          <same-length-as>events</same-length-as>
          <mode>Text</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <option>
          <name>nunit</name>
          <prompt>
            Multiplier for display of rates (1 for simple rate, 10 for &lt;rate&gt; per 10 etc.)
          </prompt>
          <default-value>1</default-value>
          <format-type>Dropdown</format-type>
          <options>
            <option value="1">1 (rate)</option>
            <option value="10">10</option>
            <option value="100">100</option>
            <option value="1000">1,000</option>
            <option value="10000">10,000</option>
            <option value="100000">100,000</option>
            <option value="1000000">1,000,000</option>
            <option value="10000000">10,000,000</option>
          </options>
        </option>
        <option>
          <name>model</name>
          <prompt>
            Select model
          </prompt>
          <default-value>poisson</default-value>
          <format-type>Dropdown</format-type>
          <options>
            <option value="poisson">Poisson model (small rates)</option>
            <option value="binomial">Binomial model</option>
          </options>
        </option>
      </parameters>
		<builtin function-name="rptStdrr" />
    <report type="application/x-statsdirect-creole" filename="stdrr.creole" />
    <report type="application/x-statsdirect-creole" filename="charts.creole" />
  </steps>
</operation>
