<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Chi2byNLinearTrend</name>
  <friendly-name lang="en-GB">Chi-square 2-by-k test with trend scores 1 to k</friendly-name>
  <help chm-id="1049" />
  <steps>
      <parameters>
        <special>
          <name>data</name>
          <must-request>true</must-request>
          <validators>
            <validator><name>NoMissingData</name></validator>
            <validator><name>TwoColumns</name></validator>
            <validator><name>NonNegative</name></validator>
            <validator><name>PositiveRows</name></validator>
          </validators>
          <type>chi-2-column</type>
        </special>
        <boolean>
          <name>doExactP</name>
          <prompt>Simulate exact P?</prompt>
          <column>2</column>
          <must-request>true</must-request>
        </boolean>
        <integer>
          <name>iterations</name>
          <prompt>Iterations</prompt>
          <acquire-if-true>=parameters.ContainsKey("doExactP") &amp;&amp; parameters["doExactP"].AsBoolean</acquire-if-true>
          <column>2</column>
          <must-request>true</must-request>
          <minimum-value>1</minimum-value>
          <default-value>1000000</default-value>
        </integer>
        <integer>
          <name>seed</name>
          <prompt>Seed</prompt>
          <acquire-if-true>=parameters.ContainsKey("doExactP") &amp;&amp; parameters["doExactP"].AsBoolean</acquire-if-true>
          <column>2</column>
          <must-request>true</must-request>
          <force-default>true</force-default>
          <default-value>=Base.DefaultSeed()</default-value>
        </integer>
        <confidence-interval>
          <name>ci</name>
          <acquire-if-true>=parameters.ContainsKey("doExactP") &amp;&amp; parameters["doExactP"].AsBoolean</acquire-if-true>
          <column>2</column>
          <must-request>true</must-request>
          <default-value>0.99</default-value>
          <can-default>false</can-default>
          <can-use-standard>false</can-use-standard>
        </confidence-interval>
      </parameters>
  	<builtin function-name="rptChi2byNLinearTrend" />
    <report type="application/x-statsdirect-creole" filename="chi2xc.creole" />
    <test>
      <condition>=parameters.ContainsKey("doExactP") &amp;&amp; parameters["doExactP"].AsBoolean</condition>
      <iftrue>
        <builtin function-name="rptChi2byNWithTrendSimulateExactP" />
        <report type="application/x-statsdirect-creole" filename="chiTwoByKSimulatedExactP.creole" />
      </iftrue>
    </test>
  </steps>
  <custom-validators>
    <custom-validator name="TwoColumns" language="CSharp">
      return (parameters[parameter.Name].IsDataFrame &amp;&amp; parameters[parameter.Name].AsDataFrame.VariableCount == 2) ? null : "Values should be entered in both columns";
    </custom-validator>
  </custom-validators>
  <suggested-operations>
    <suggested-operation>Chi2byNLinearTrend</suggested-operation>
  </suggested-operations>
</operation>
