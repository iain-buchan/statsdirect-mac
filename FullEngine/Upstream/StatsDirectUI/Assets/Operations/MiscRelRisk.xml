<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>MiscRelRisk</name>
  <friendly-name lang="en-GB">Risk (prospective) calculation with summary counts</friendly-name>
  <help chm-id="1220" />
  <steps>
      <parameters>
        <double-2-by-2>
          <name>scrap</name>
          <columns-prompt>Characteristic (press F1 for an example)</columns-prompt>
          <left-column-prompt>Present</left-column-prompt>
          <right-column-prompt>Absent</right-column-prompt>
          <rows-prompt>Outcome:</rows-prompt>
          <top-row-prompt>Present</top-row-prompt>
          <bottom-row-prompt>Absent</bottom-row-prompt>
          <top-left-name>a</top-left-name>
          <top-right-name>b</top-right-name>
          <bottom-left-name>c</bottom-left-name>
          <bottom-right-name>d</bottom-right-name>
          <must-request>true</must-request>
        </double-2-by-2>
        <double>
          <name>pe</name>
          <must-request>true</must-request>
          <prompt>Population proportion exposed (optional)</prompt>
          <acquire-if-true>=parameters.ContainsKey("a") &amp;&amp; parameters.ContainsKey("b") &amp;&amp; parameters.ContainsKey("c") &amp;&amp; parameters.ContainsKey("d") &amp;&amp; (((parameters["a"].AsDouble) / (parameters["a"].AsDouble + parameters["c"].AsDouble)) / ((parameters["b"].AsDouble) / (parameters["b"].AsDouble + parameters["d"].AsDouble))) &gt; 1.0</acquire-if-true>
          <cancel-skips-parameter>true</cancel-skips-parameter>
          <minimum-value>0</minimum-value>
          <maximum-value>1</maximum-value>
        </double>
        <confidence-interval>
          <name>cco</name>
          <must-request>true</must-request>
        </confidence-interval>
      </parameters>
  	<builtin function-name="rptMiscRelRisk" />
    <report type="application/x-statsdirect-creole" filename="relrisk.creole" />
	</steps>
  <suggested-operations>
    <suggested-operation>MiscRelRisk</suggested-operation>
  </suggested-operations>
</operation>
