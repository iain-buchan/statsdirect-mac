<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>SizeIndCase</name>
  <friendly-name lang="en-GB">Sample size for independent case-control study</friendly-name>
  <help chm-id="1313" />
  <steps>
      <parameters>
        <double>
          <name>p0</name>
          <prompt>Probability of exposure in controls</prompt>
          <must-request>true</must-request>
        </double>
        <option>
          <name>prop-or-or</name>
          <prompt></prompt>
          <must-request>true</must-request>
          <default-value>prop</default-value>
          <options>
            <option value="prop">Two Proportions</option>
            <option value="or">Odds Ratio</option>
          </options>
        </option>
        <double>
          <name>p1</name>
          <prompt>Probability of exposure in subjects</prompt>
          <must-request>true</must-request>
          <acquire-if-true language="c#">=!(parameters.ContainsKey("prop-or-or") &amp;&amp; "or".Equals(parameters["prop-or-or"].AsString))</acquire-if-true>
        </double>
        <double>
          <name>r</name>
          <prompt>Ratio of exposures between cases and controls</prompt>
          <must-request>true</must-request>
          <acquire-if-true language="c#">=parameters.ContainsKey("prop-or-or") &amp;&amp; "or".Equals(parameters["prop-or-or"].AsString)</acquire-if-true>
        </double>
        <double>
          <name>m</name>
          <prompt>Number of controls per case</prompt>
          <must-request>true</must-request>
          <minimum-value>0</minimum-value>
          <default-value>1</default-value>
        </double>
        <confidence-interval>
          <name>p</name>
          <prompt>% POWER (% probability of correctly detecting a real effect)</prompt>
          <must-request>true</must-request>
          <minimum-suggested-value>0.7</minimum-suggested-value>
          <maximum-suggested-value>0.95</maximum-suggested-value>
          <suggested-step>0.05</suggested-step>
          <default-value>0.8</default-value>
          <can-default>false</can-default>
        </confidence-interval>
        <confidence-interval>
          <name>a</name>
          <prompt>% ALPHA (% probability of incorrectly rejecting the null hypothesis)</prompt>
          <must-request>true</must-request>
          <minimum-suggested-value>0.001</minimum-suggested-value>
          <maximum-suggested-value>0.05</maximum-suggested-value>
          <suggested-step>0.001</suggested-step>
          <default-value>0.05</default-value>
          <can-default>false</can-default>
        </confidence-interval>
      </parameters>
  	<builtin function-name="rptSizeIndCase" />
    <report type="application/x-statsdirect-creole" filename="s_incase.creole" />
	</steps>
  <suggested-operations>
    <suggested-operation>SizeIndCase</suggested-operation>
  </suggested-operations>
</operation>
