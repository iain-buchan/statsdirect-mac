<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>CiMeanY</name>
	<friendly-name lang="en-GB">CI for a mean value of Y for a given X</friendly-name>
  <prerequisite-operation>SimpleLinearRegression</prerequisite-operation>
  <steps>
      <parameters>
        <confidence-interval>
          <name>reggamma</name>
        </confidence-interval>
        <double>
          <name>xa</name>
          <prompt>X value</prompt>
        </double>
      </parameters>
		<builtin function-name="rptCiMeanY" />
    <report type="application/x-statsdirect-creole" filename="cimeany.creole" />
	</steps>
</operation>
