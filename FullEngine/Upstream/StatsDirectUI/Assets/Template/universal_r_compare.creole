<table>
<tr><th></th><th>Group 1</th><th>Group 2</th><th>Difference</th></tr>
<tr><td>R:</td><td>@{r1:roundu} </td><td> @{r2:roundu}</td><td>@{dr:roundu}</td></tr>
<tr><td>Delta:</td><td>@{mu1:roundu} </td><td> @{mu2:roundu}</td><td>@{dm:roundu}</td></tr>
