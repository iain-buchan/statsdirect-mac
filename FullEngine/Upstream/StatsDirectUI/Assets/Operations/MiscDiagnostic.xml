<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>MiscDiagnostic</name>
  <friendly-name lang="en-GB">Dignostic test performance analysis</friendly-name>
  <help chm-id="1215" />
  <steps>
      <parameters>
        <double-2-by-2>
          <name>scrap</name>
          <columns-prompt>Disease or feature:</columns-prompt>
          <left-column-prompt>Present</left-column-prompt>
          <right-column-prompt>Absent</right-column-prompt>
          <rows-prompt>Test:</rows-prompt>
          <top-row-prompt>Positive</top-row-prompt>
          <bottom-row-prompt>Negative</bottom-row-prompt>
          <top-left-name>a</top-left-name>
          <top-right-name>b</top-right-name>
          <bottom-left-name>c</bottom-left-name>
          <bottom-right-name>d</bottom-right-name>
          <must-request>true</must-request>
        </double-2-by-2>
        <confidence-interval>
          <name>cco</name>
          <must-request>true</must-request>
        </confidence-interval>
      </parameters>
  	<builtin function-name="rptMiscDiagnostic" />
    <report type="application/x-statsdirect-creole" filename="diagnost.creole" />
	</steps>
  <suggested-operations>
    <suggested-operation>MiscDiagnostic</suggested-operation>
  </suggested-operations>
</operation>
