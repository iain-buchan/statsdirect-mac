<report>
<title>Quantile confidence interval</title>
<block name="variable">

<p>Variable: @sample<br />
Sample size = @size<br />
Quantile (@quantile_name) = @{value:roundu}<br />
<ci>Approximate @{pc:round2}% CI @type = @note_from@{from:roundu} to @note_to@{to:roundu}</ci><br />
Exact confidence level = @{exact:roundu}%@note_text</p>
</block>
</report>
