<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>SizeUnPaired</name>
  <friendly-name lang="en-GB">Sample size for an unpaired t test</friendly-name>
  <help chm-id="1319" />
  <steps>
      <parameters>
        <double>
          <name>d</name>
          <prompt>Difference in population means</prompt>
          <must-request>true</must-request>
        </double>
        <double>
          <name>sd</name>
          <prompt>Estimate of population SD</prompt>
          <must-request>true</must-request>
          <lifetime>SessionForThisOperation</lifetime>
        </double>
        <double>
          <name>m</name>
          <prompt>Controls per experimental subject</prompt>
          <must-request>true</must-request>
          <minimum-value>0</minimum-value>
          <default-value>1</default-value>
        </double>
        <confidence-interval>
          <name>p</name>
          <prompt>% POWER (% probability of correctly detecting a real effect)</prompt>
          <minimum-suggested-value>0.7</minimum-suggested-value>
          <maximum-suggested-value>0.95</maximum-suggested-value>
          <suggested-step>0.05</suggested-step>
          <default-value>0.8</default-value>
          <must-request>true</must-request>
          <can-default>false</can-default>
        </confidence-interval>
        <confidence-interval>
          <name>a</name>
          <prompt>% ALPHA (% probability of incorrectly rejecting the null hypothesis)</prompt>
          <minimum-suggested-value>0.001</minimum-suggested-value>
          <maximum-suggested-value>0.05</maximum-suggested-value>
          <suggested-step>0.001</suggested-step>
          <default-value>0.05</default-value>
          <must-request>true</must-request>
          <can-default>false</can-default>
        </confidence-interval>
      </parameters>
  	<builtin function-name="rptSizeUnPaired" />
    <report type="application/x-statsdirect-creole" filename="s_t.creole" />
  </steps>
  <suggested-operations>
    <suggested-operation>SizeUnPaired</suggested-operation>
  </suggested-operations>
</operation>
