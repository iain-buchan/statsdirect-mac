<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>BarPlotFrequency</name>
  <friendly-name lang="en-GB">Bar plots</friendly-name>
  <help chm-id="1334" />
  <steps>
      <parameters>
        <frame>
          <name>rawValues</name>
          <prompt>Select categorical data to plot as frequencies</prompt>
          <mode>CategoryReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>10</max-columns>
          <clear-selection-first>true</clear-selection-first>
          <ask-for-group-id>true</ask-for-group-id>
        </frame>
      </parameters>
    <builtin function-name="valuesToFrequencies"/>
		<chart>
			<chart-name>chart</chart-name>
			<chart-type>Bar</chart-type>
			<box-axes>false</box-axes>
      <y-series-data>values</y-series-data>
		</chart>
    <report type="application/x-statsdirect-creole" filename="chartonly.creole" />
	</steps>
</operation>
