<report>
  <title>Kruskal-Wallis: all pairwise comparisons (Conover-Iman, 1-sided)</title>
  <p>Critical t (@{df:round0} df, @{sided:roundu}-sided) = @{t:roundu}</p>

  <block name="conover">
    <table>
      <tr>
        <td>@t1 @compare @t2</td>
        <td>
          <ci>@diff</ci>
        </td>
      </tr>
      <tr>
        <td>(@{stata:roundu} > @{statb:roundu})</td>
        <td>
          <pval>@{p:pval}</pval>
        </td>
      </tr>
    </table>
  </block>
</report>
