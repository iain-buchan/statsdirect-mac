<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>GroupedLinearity</name>
  <friendly-name lang="en-GB">Analysis of linearity</friendly-name>
  <help chm-id="1275" />
  <steps>
      <parameters>
        <frame>
          <name>predictor</name>
          <prompt>Select data for PREDICTOR (x axis)</prompt>
          <mode>NumericSkipMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>outcomes</name>
          <prompt>Select data for OUTCOME (Y axis) replicates for x levels</prompt>
          <mode>NumericSkipMissing</mode>
          <min-columns>=parameters["predictor"].AsDataFrame.Variables[0].Length</min-columns>
          <max-columns>=parameters["predictor"].AsDataFrame.Variables[0].Length</max-columns>
          <clear-selection-first>true</clear-selection-first>
          <ask-for-group-id>true</ask-for-group-id>
        </frame>
      </parameters>
		<builtin function-name="rptGroupedLinearity" />
    <report type="application/x-statsdirect-creole" filename="grprep.creole" />
	</steps>
</operation>
