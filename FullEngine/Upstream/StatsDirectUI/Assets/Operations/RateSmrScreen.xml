<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>RateSmrScreen</name>
  <friendly-name lang="en-GB">Indirect standardization and SMR</friendly-name>
  <help chm-id="1265" />
  <steps>
      <parameters>
        <special>
          <name>data</name>
          <must-request>true</must-request>
          <type>rr-index</type>
        </special>
        <option>
          <name>nunit</name>
          <prompt>Multiplier for reference population rates</prompt>
          <must-request>true</must-request>
          <column>2</column>
          <default-value>1</default-value>
          <format-type>Dropdown</format-type>
          <options>
            <option value="1">1 (rate)</option>
            <option value="10">per 10</option>
            <option value="100">per 100</option>
            <option value="1000">per 1,000</option>
            <option value="10000">per 10,000</option>
            <option value="100000">per 100,000</option>
            <option value="1000000">per 1,000,000</option>
            <option value="10000000">per 10,000,000</option>
            <option value="100000000">per 100,000,000</option>
          </options>
        </option>
        <double>
          <name>dead</name>
          <prompt>Number of deaths observed in index population or sample</prompt>
          <must-request>true</must-request>
          <column>2</column>
        </double>
        <confidence-interval>
          <name>cco</name>
          <must-request>true</must-request>
        </confidence-interval>
      </parameters>
  	<builtin function-name="rptRateSMR" />
    <report type="application/x-statsdirect-creole" filename="stdmort.creole" />
	</steps>
  <suggested-operations>
    <suggested-operation>RateSmrScreen</suggested-operation>
  </suggested-operations>
</operation>
