<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>PoissonRegressionIRR</name>
	<friendly-name lang="en-GB">Incidence rate ratio (relative risk)</friendly-name>
  <prerequisite-operation>PoissonRegression</prerequisite-operation>
  <steps>
    <builtin function-name="opPoissonRegressionIrrMakeDichotomousCovariates" />
      <parameters>
        <confidence-interval>
          <name>gamma</name>
        </confidence-interval>
        <pick-from-list>
          <name>cov</name>
          <prompt>Select covariate for sub-population relative risk</prompt>
          <acquire-if-true>=parameters["hasDichotomousCovariates"].AsBoolean</acquire-if-true>
          <must-request>true</must-request>
          <source>dichotomousCovariates</source>
        </pick-from-list>
      </parameters>
		<builtin function-name="rptPoissonRegressionIrr" />
    <report type="application/x-statsdirect-creole">
      <![CDATA[<report>
<title>Poisson regression - incidence rate ratios (relative risks)</title>
<block name="pop">

<p>Inference population: @pop</p>
<table>
<tr><th>Parameter</th><th>Coefficient</th><th>IRR</th><th><ci>@{pc:round2}% CI</ci></th></tr>
<block name="par"><tr><td>@par</td><td>@{est:roundu}</td><td>@{irr:roundu}</td><td><ci>@{lci:roundu}  to  @{uci:roundu}</ci></td></tr></block>
</table>
</block>
</report>]]>
    </report>
  </steps>
</operation>
