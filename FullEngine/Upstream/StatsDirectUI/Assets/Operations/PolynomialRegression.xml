<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>PolynomialRegression</name>
	<friendly-name lang="en-GB">Polynomial regression</friendly-name>
  <help chm-id="1282" />
  <steps>
      <parameters>
        <frame>
          <name>y</name>
          <prompt>Select data for OUTCOME (Y axis)</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>x</name>
          <prompt>Select data for PREDICTOR (X axis)</prompt>
          <mode>NumericReplaceMissing</mode>
          <same-length-as>y</same-length-as>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <option>
          <name>degree</name>
          <prompt>Select degree</prompt>
          <default-value>2</default-value>
          <options>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
            <option value="7">7</option>
            <option value="8">8</option>
            <option value="9">9</option>
          </options>
          <must-request>true</must-request>
        </option>
      </parameters>
		<builtin function-name="rptPolynomialRegression" />
    <report type="application/x-statsdirect-creole" filename="poly.creole" />
	</steps>
  <suggested-operations>
    <suggested-operation>PolynomialRegressionChangeDegree</suggested-operation>
    <suggested-operation>MultipleLinearRegressionAnova</suggested-operation>
    <suggested-operation>PolynomialRegressionInterpolation</suggested-operation>
    <suggested-operation>PolynomialRegressionPlot</suggested-operation>
    <suggested-operation>PolynomialAreaUnderCurve</suggested-operation>
    <suggested-operation>PolynomialRegressionConfidence</suggested-operation>
    <suggested-operation>PolynomialRegressionBackInterpolation</suggested-operation>
  </suggested-operations>
</operation>
