<report>
<title>Random allocation in blocks</title>

<p>Randomized with seed: @seed_out</p>

<table>
<tr><td>Subjects:</td><td>@n_out</td></tr>
<tr><td>Block size:</td><td>@b_out</td></tr>
<tr><td>Treatments:</td><td>@t_out</td></tr>
</table>

<block name="blockSizeWarn"><p><warn>@warning</warn></p></block>

<table>
<tr><th>Subject</th><th>Treatment</th></tr>
<block name="subjects"><tr><td>@id</td><td>@rx</td></tr></block>
</table>
</report>
