<report>
<title>Frequencies</title>
<block name="variable">
<subtitle>Frequency analysis for @ti</subtitle>

<p>Total = @n</p>

<table>
<tr><th>Value</th><th>Frequency</th><th>Relative %</th><th>Cumulative</th><th>Cumulative Relative %</th></tr>
<block name="bin"><tr><td>@x</td><td>@fx</td><td>@{pc:roundu}</td><td>@cm</td><td>@{pc2:roundu}</td></tr></block>
</table>
</block>
</report>