<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
  <name>LogRank</name>
  <friendly-name lang="en-GB">Log-rank test</friendly-name>
  <help chm-id="1325" />
  <steps>
    <parameters>
      <frame>
        <name>gid</name>
        <prompt>Select data for GROUP IDENTIFIER</prompt>
        <mode>CategoryReplaceMissing</mode>
        <min-columns>1</min-columns>
        <max-columns>1</max-columns>
        <clear-selection-first>true</clear-selection-first>
      </frame>
      <frame>
        <name>times</name>
        <prompt>Select data for TIMES</prompt>
        <same-length-as>gid</same-length-as>
        <mode>NumericReplaceMissing</mode>
        <min-columns>1</min-columns>
        <max-columns>1</max-columns>
        <clear-selection-first>true</clear-selection-first>
      </frame>
      <frame>
        <name>deaths</name>
        <prompt>Select data for DEATHS/EVENTS or CENSORED{0}</prompt>
        <same-length-as>gid</same-length-as>
        <mode>NumericReplaceMissing</mode>
        <min-columns>1</min-columns>
        <max-columns>1</max-columns>
        <clear-selection-first>true</clear-selection-first>
      </frame>
      <frame>
        <name>strata</name>
        <prompt>Select data for STRATA (skip for non-stratified)</prompt>
        <cancel-skips-parameter>Skip</cancel-skips-parameter>
        <same-length-as>gid</same-length-as>
        <mode>CategoryReplaceMissing</mode>
        <min-columns>1</min-columns>
        <max-columns>1</max-columns>
        <clear-selection-first>true</clear-selection-first>
      </frame>
      <confidence-interval>
        <name>gamma</name>
      </confidence-interval>
      <option>
        <name>wt_method</name>
        <prompt>Select weighting method</prompt>
        <must-request>true</must-request>
        <default-value>1</default-value>
        <options>
          <option value="1">Peto-Prentice</option>
          <option value="2">Gehan-Breslow</option>
          <option value="3">Tarone-Ware</option>
        </options>
      </option>
    </parameters>
    <builtin function-name="rptLogRankPreprocess" />
    <test>
      <condition>=parameters.ContainsKey("group_scores")</condition>
      <iftrue>
        <parameters>
          <special>
            <name>group_scores</name>
            <prompt>Group scores for trend test</prompt>
            <must-request>true</must-request>
            <type>1-to-n</type>
          </special>
        </parameters>
      </iftrue>
    </test>
    <builtin function-name="rptLogRank" />
    <report type="application/x-statsdirect-creole" filename="logrank.creole" />
  </steps>
</operation>
