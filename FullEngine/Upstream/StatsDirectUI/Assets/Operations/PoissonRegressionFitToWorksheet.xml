<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>PoissonRegressionFitToWorksheet</name>
	<friendly-name lang="en-GB">Fits and residuals to worksheet</friendly-name>
  <prerequisite-operation>PoissonRegression</prerequisite-operation>
  <steps>
		<builtin function-name="rptPoissonRegressionFit" />
      <parameters>
        <multiple-options>
          <prompt>Save fits and residuals to a worksheet</prompt>
          <options>
            <option selected="true" name="expectedEvents">Expected events</option>
            <option selected="true" name="expectedIncidence">Expected incidence</option>
            <option selected="true" name="residualEvents">Residual events</option>
            <option selected="true" name="freemanTukeyResidual">Freeman-Tukey residual</option>
            <option selected="true" name="devianceResidual">Deviance residual</option>
            <option selected="true" name="pearsonResidual">Pearson residual</option>
            <option selected="true" name="leverage">Leverage</option>
            <option selected="true" name="stdPearsonResidual">Std Pearson residual</option>
          </options>
        </multiple-options>
      </parameters>
		<builtin function-name="gridPoissonRegressionFit" />
		<output-frame frame-name="results" />
	</steps>
</operation>
