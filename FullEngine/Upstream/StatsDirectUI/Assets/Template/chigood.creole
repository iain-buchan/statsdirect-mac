<report>
<title>Chi-square goodness of fit</title>

<p>Sample: @ti:</p>

<p><subtotal>N = @n</subtotal></p>

<table>
<tr><th>Count</th><th>Observed frequency</th><th>Expected frequency</th></tr>
<block name="frequencies"><tr><td>@x</td><td>@o</td><td>@{e:roundu}</td></tr></block>
</table>

<p>Chi-square = @{chi2:roundu}  df = @df<br />
<pval>@{p:pval}</pval></p>

<block name="warn"><p><warn>@warn</warn></p></block>
</report>
