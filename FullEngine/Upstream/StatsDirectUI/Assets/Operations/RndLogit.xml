<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>RndLogit</name>
  <friendly-name lang="en-GB">Random numbers: Logit</friendly-name>
  <help chm-id="1258" />
  <steps>
      <parameters>
        <integer>
          <name>cols</name>
          <prompt>How many columns to fill?</prompt>
          <minimum-value>1</minimum-value>
          <maximum-value>100</maximum-value>
          <default-value>1</default-value>
        </integer>
        <integer>
          <name>rows</name>
          <prompt>How many rows to fill?</prompt>
          <minimum-value>1</minimum-value>
          <maximum-value>1000000</maximum-value>
          <default-value>100</default-value>
        </integer>
        <double>
          <name>mu</name>
          <prompt>Mu (location parameter)</prompt>
          <default-value>0</default-value>
        </double>
        <double>
          <name>sigma</name>
          <prompt>Sigma (scale parameter)</prompt>
          <default-value>1</default-value>
        </double>
        <integer>
          <name>seed</name>
          <prompt>Seed for random number generator</prompt>
          <default-value>=Base.DefaultSeed()</default-value>
        </integer>
      </parameters>
  	<builtin function-name="shtRndLogit" />
	  <output-frame frame-name="output" default-placement="BeforeSelection"/>
	</steps>
</operation>
