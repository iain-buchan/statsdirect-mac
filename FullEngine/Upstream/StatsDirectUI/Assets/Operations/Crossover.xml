<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Crossover</name>
  <friendly-name lang="en-GB">Crossover analysis of variance</friendly-name>
  <help chm-id="1006" />
  <steps>
      <parameters>
        <confidence-interval>
          <name>gamma</name>
        </confidence-interval>
        <frame>
          <name>group1drug</name>
          <prompt>Select data for Group 1 DRUG</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>group1placebo</name>
          <prompt>Select data for Group 1 PLACEBO</prompt>
          <mode>NumericReplaceMissing</mode>
          <same-length-as>group1drug</same-length-as>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>group1baseline</name>
          <prompt>Select data for Group 1 BASELINE (skip if none)</prompt>
          <cancel-skips-parameter>Skip</cancel-skips-parameter>
          <mode>NumericReplaceMissing</mode>
          <same-length-as>group1drug</same-length-as>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>group2drug</name>
          <prompt>Select data for Group 2 DRUG</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>group2placebo</name>
          <prompt>Select data for Group 2 PLACEBO</prompt>
          <mode>NumericReplaceMissing</mode>
          <same-length-as>group2drug</same-length-as>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>group2baseline</name>
          <requires-parameter>group1baseline</requires-parameter>
          <prompt>Select data for Group 2 BASELINE (skip if none)</prompt>
          <cancel-skips-parameter>Skip</cancel-skips-parameter>
          <mode>NumericReplaceMissing</mode>
          <same-length-as>group2drug</same-length-as>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
      </parameters>
		<builtin function-name="rptCrossover" />
    <report type="application/x-statsdirect-creole" filename="xover.creole" />
	</steps>
</operation>
